{% doc %}
  @prompt
    Add consistent left and right padding/margins to the EDM signup section (edm-signup.liquid) so it matches the horizontal spacing of other sections on the page. The other sections use standard page-width container spacing. Apply the same left and right padding to the EDM signup section wrapper so it looks visually consistent from both left and right sides.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-edm-signup-{{ ai_gen_id }} {
    width: 100%;
    padding-left: {{ block.settings.horizontal_padding_mobile }}px;
    padding-right: {{ block.settings.horizontal_padding_mobile }}px;
    padding-top: {{ block.settings.vertical_padding }}px;
    padding-bottom: {{ block.settings.vertical_padding }}px;
    background-color: {{ block.settings.background_color }};
  }

  @media screen and (min-width: 750px) {
    .ai-edm-signup-{{ ai_gen_id }} {
      padding-left: {{ block.settings.horizontal_padding_desktop }}px;
      padding-right: {{ block.settings.horizontal_padding_desktop }}px;
    }
  }

  .ai-edm-signup-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
    align-items: {{ block.settings.text_alignment }};
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-edm-signup-heading-{{ ai_gen_id }} {
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size_mobile }}px;
  }

  @media screen and (min-width: 750px) {
    .ai-edm-signup-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
    }
  }

  .ai-edm-signup-text-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_size }}px;
    margin: 0;
  }

  .ai-edm-signup-form-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.form_max_width }}px;
  }

  .ai-edm-signup-field-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  @media screen and (min-width: 750px) {
    .ai-edm-signup-field-wrapper-{{ ai_gen_id }} {
      flex-direction: row;
    }
  }

  .ai-edm-signup-input-{{ ai_gen_id }} {
    flex: 1;
    padding: {{ block.settings.input_padding }}px;
    border: {{ block.settings.input_border_width }}px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    background-color: {{ block.settings.input_bg_color }};
    color: {{ block.settings.input_text_color }};
    font-size: {{ block.settings.input_text_size }}px;
  }

  .ai-edm-signup-input-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.placeholder_color }};
  }

  .ai-edm-signup-button-{{ ai_gen_id }} {
    padding: {{ block.settings.button_padding }}px {{ block.settings.button_padding | times: 2 }}px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_text_size }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .ai-edm-signup-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  .ai-edm-signup-message-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    margin-top: 8px;
  }

  .ai-edm-signup-success-{{ ai_gen_id }} {
    color: {{ block.settings.success_color }};
  }

  .ai-edm-signup-error-{{ ai_gen_id }} {
    color: {{ block.settings.error_color }};
  }
{% endstyle %}

<div class="ai-edm-signup-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-edm-signup-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-edm-signup-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    {% if block.settings.description != blank %}
      <div class="ai-edm-signup-text-{{ ai_gen_id }}">
        {{ block.settings.description }}
      </div>
    {% endif %}

    {%- form 'customer', class: 'ai-edm-signup-form-' | append: ai_gen_id -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      
      <div class="ai-edm-signup-field-wrapper-{{ ai_gen_id }}">
        <input
          type="email"
          name="contact[email]"
          class="ai-edm-signup-input-{{ ai_gen_id }}"
          value="{{ form.email }}"
          placeholder="{{ block.settings.email_placeholder }}"
          aria-label="Email address"
          aria-required="true"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="ai-edm-signup-error-{{ ai_gen_id }}"
          {% endif %}
          {% if form.posted_successfully? %}
            aria-describedby="ai-edm-signup-success-{{ ai_gen_id }}"
          {% endif %}
          required
        >
        
        <button
          type="submit"
          class="ai-edm-signup-button-{{ ai_gen_id }}"
        >
          {{ block.settings.button_text }}
        </button>
      </div>

      {% if form.errors %}
        <div
          id="ai-edm-signup-error-{{ ai_gen_id }}"
          class="ai-edm-signup-message-{{ ai_gen_id }} ai-edm-signup-error-{{ ai_gen_id }}"
        >
          {{ form.errors.messages.email }}
        </div>
      {% endif %}

      {% if form.posted_successfully? %}
        <div
          id="ai-edm-signup-success-{{ ai_gen_id }}"
          class="ai-edm-signup-message-{{ ai_gen_id }} ai-edm-signup-success-{{ ai_gen_id }}"
        >
          {{ block.settings.success_message }}
        </div>
      {% endif %}
    {%- endform -%}
  </div>
</div>

