{% doc %}
  @prompt
    Create a new email signup section (similar to a newsletter "Join the List" EDM signup layout) with the following built-in theme editor controls in the section schema: a font_picker setting for the heading font (so the merchant can choose any system/Shopify font including handwriting/script fonts), a range slider for heading font size, a color picker for background color, separate range sliders for top, bottom, left, and right padding, a text setting for the heading (default: "Join the List"), a text setting for a subheading, an email input field with a submit button, clean minimal layout centered on the page. All settings accessible from the Shopify theme editor sidebar., font style didnt change and make sure it could vertical in desktop or mobile
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-email-signup-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    padding-left: {{ block.settings.padding_left }}px;
    padding-right: {{ block.settings.padding_right }}px;
    width: 100%;
  }

  .ai-email-signup-container-{{ ai_gen_id }} {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }

  .ai-email-signup-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    font-size: {{ block.settings.heading_font_size }}px;
    line-height: 1.2;
    margin: 0 0 16px;
    color: inherit;
  }

  @supports (font-variation-settings: normal) {
    .ai-email-signup-heading-{{ ai_gen_id }} {
      font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    }
  }

  .ai-email-signup-subheading-{{ ai_gen_id }} {
    font-size: 16px;
    margin: 0 0 24px;
    color: inherit;
    opacity: 0.9;
  }

  .ai-email-signup-form-{{ ai_gen_id }} {
    display: flex;
    {% if block.settings.layout_desktop == 'vertical' %}
      flex-direction: column;
    {% else %}
      flex-direction: row;
    {% endif %}
    gap: 12px;
    max-width: 500px;
    margin: 0 auto;
  }

  .ai-email-signup-input-{{ ai_gen_id }} {
    flex: 1;
    padding: 14px 16px;
    border: 1px solid rgba(0, 0, 0, 0.2);
    border-radius: 4px;
    font-size: 14px;
  }

  .ai-email-signup-button-{{ ai_gen_id }} {
    padding: 14px 32px;
    background-color: #000000;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font-size: 14px;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.3s ease;
    {% if block.settings.layout_desktop == 'vertical' %}
      width: 100%;
    {% endif %}
  }

  .ai-email-signup-button-{{ ai_gen_id }}:hover {
    opacity: 0.8;
  }

  .ai-email-signup-success-{{ ai_gen_id }} {
    color: #008060;
    margin-top: 12px;
    font-size: 14px;
  }

  .ai-email-signup-error-{{ ai_gen_id }} {
    color: #D82C0D;
    margin-top: 12px;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-email-signup-{{ ai_gen_id }} {
      padding-left: {{ block.settings.padding_left | times: 0.5 }}px;
      padding-right: {{ block.settings.padding_right | times: 0.5 }}px;
    }

    .ai-email-signup-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_font_size | times: 0.7 }}px;
    }

    .ai-email-signup-form-{{ ai_gen_id }} {
      {% if block.settings.layout_mobile == 'vertical' %}
        flex-direction: column;
      {% else %}
        flex-direction: row;
      {% endif %}
    }

    .ai-email-signup-button-{{ ai_gen_id }} {
      {% if block.settings.layout_mobile == 'vertical' %}
        width: 100%;
      {% endif %}
    }
  }
{% endstyle %}

<div class="ai-email-signup-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-email-signup-container-{{ ai_gen_id }}">
    {%- if block.settings.heading != blank -%}
      <h2 class="ai-email-signup-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {%- endif -%}

    {%- if block.settings.subheading != blank -%}
      <p class="ai-email-signup-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'ai-email-signup-form-wrapper' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="ai-email-signup-form-{{ ai_gen_id }}">
        <input
          type="email"
          name="contact[email]"
          class="ai-email-signup-input-{{ ai_gen_id }}"
          value="{{ form.email }}"
          placeholder="Enter your email"
          aria-required="true"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          {% if form.errors %}
            aria-invalid="true"
            aria-describedby="ai-email-signup-error-{{ ai_gen_id }}"
          {% endif %}
          {% if form.posted_successfully? %}
            aria-describedby="ai-email-signup-success-{{ ai_gen_id }}"
          {% endif %}
          required
        >
        <button type="submit" class="ai-email-signup-button-{{ ai_gen_id }}">
          Subscribe
        </button>
      </div>

      {%- if form.errors -%}
        <div id="ai-email-signup-error-{{ ai_gen_id }}" class="ai-email-signup-error-{{ ai_gen_id }}">
          {{ form.errors.messages.email }}
        </div>
      {%- endif -%}

      {%- if form.posted_successfully? -%}
        <div id="ai-email-signup-success-{{ ai_gen_id }}" class="ai-email-signup-success-{{ ai_gen_id }}">
          Thanks for subscribing!
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Email signup",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the List"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Subscribe to get special offers and updates"
    },
    {
      "type": "header",
      "content": "Heading style"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Font",
      "default": "assistant_n4"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Font size",
      "default": 40
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_desktop",
      "label": "Desktop layout",
      "options": [
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "vertical",
          "label": "Vertical"
        }
      ],
      "default": "horizontal"
    },
    {
      "type": "select",
      "id": "layout_mobile",
      "label": "Mobile layout",
      "options": [
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "vertical",
          "label": "Vertical"
        }
      ],
      "default": "vertical"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f7f7f7"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Left padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Right padding",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Email signup"
    }
  ]
}
{% endschema %}
