{% doc %}
  @prompt
    Add a "Read More / Read Less" toggle to the Klaviyo Reviews product reviews list on the product page. Truncate each review body text to approximately 3–4 lines using CSS line-clamp or max-height with overflow hidden. Inject a "Read more" tap button below each truncated review that expands the full text when tapped, and changes to "Read less" to collapse it back. The button should match the store's existing link or accent color style. This should work on both mobile and desktop.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .klaviyo-reviews-toggle-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .klaviyo-reviews-toggle-{{ ai_gen_id }} .klaviyo-review-body {
    position: relative;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .klaviyo-reviews-toggle-{{ ai_gen_id }} .klaviyo-review-body.truncated {
    display: -webkit-box;
    -webkit-line-clamp: {{ block.settings.line_clamp }};
    -webkit-box-orient: vertical;
    overflow: hidden;
    max-height: calc({{ block.settings.line_clamp }} * 1.5em);
  }

  .klaviyo-reviews-toggle-{{ ai_gen_id }} .klaviyo-review-body.expanded {
    display: block;
    -webkit-line-clamp: unset;
    max-height: none;
  }

  .klaviyo-reviews-toggle-{{ ai_gen_id }} .read-more-btn {
    background: none;
    border: none;
    color: {{ block.settings.button_color }};
    cursor: pointer;
    padding: {{ block.settings.button_padding }}px 0;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    text-decoration: {{ block.settings.button_text_decoration }};
    margin-top: {{ block.settings.button_margin_top }}px;
    display: inline-block;
    transition: opacity 0.2s ease;
  }

  .klaviyo-reviews-toggle-{{ ai_gen_id }} .read-more-btn:hover {
    opacity: 0.7;
  }

  .klaviyo-reviews-toggle-{{ ai_gen_id }} .read-more-btn:focus {
    outline: 2px solid {{ block.settings.button_color }};
    outline-offset: 2px;
  }

  @media screen and (max-width: 749px) {
    .klaviyo-reviews-toggle-{{ ai_gen_id }} .read-more-btn {
      font-size: {{ block.settings.button_font_size_mobile }}px;
    }
  }
{% endstyle %}

<klaviyo-reviews-toggle-{{ ai_gen_id }}
  class="klaviyo-reviews-toggle-{{ ai_gen_id }}"
  data-read-more-text="{{ block.settings.read_more_text }}"
  data-read-less-text="{{ block.settings.read_less_text }}"
  {{ block.shopify_attributes }}
>
</klaviyo-reviews-toggle-{{ ai_gen_id }}>

<script>
  (function() {
    class KlaviyoReviewsToggle{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.readMoreText = this.dataset.readMoreText;
        this.readLessText = this.dataset.readLessText;
        this.observer = null;
      }

      connectedCallback() {
        this.initObserver();
        this.processExistingReviews();
      }

      disconnectedCallback() {
        if (this.observer) {
          this.observer.disconnect();
        }
      }

      initObserver() {
        this.observer = new MutationObserver((mutations) => {
          mutations.forEach((mutation) => {
            if (mutation.addedNodes.length) {
              this.processExistingReviews();
            }
          });
        });

        this.observer.observe(document.body, {
          childList: true,
          subtree: true
        });
      }

      processExistingReviews() {
        const reviewBodies = document.querySelectorAll('.klaviyo-review-body, [class*="review-body"], [class*="reviewBody"]');
        
        reviewBodies.forEach((reviewBody) => {
          if (reviewBody.dataset.toggleProcessed) {
            return;
          }

          const textContent = reviewBody.textContent.trim();
          const lineHeight = parseFloat(getComputedStyle(reviewBody).lineHeight) || 24;
          const maxHeight = lineHeight * {{ block.settings.line_clamp }};
          
          if (reviewBody.scrollHeight > maxHeight + 10) {
            this.addToggleButton(reviewBody);
            reviewBody.dataset.toggleProcessed = 'true';
          }
        });
      }

      addToggleButton(reviewBody) {
        reviewBody.classList.add('truncated');
        
        const button = document.createElement('button');
        button.className = 'read-more-btn';
        button.textContent = this.readMoreText;
        button.setAttribute('aria-expanded', 'false');
        button.setAttribute('type', 'button');
        
        button.addEventListener('click', () => {
          const isExpanded = reviewBody.classList.contains('expanded');
          
          if (isExpanded) {
            reviewBody.classList.remove('expanded');
            reviewBody.classList.add('truncated');
            button.textContent = this.readMoreText;
            button.setAttribute('aria-expanded', 'false');
          } else {
            reviewBody.classList.remove('truncated');
            reviewBody.classList.add('expanded');
            button.textContent = this.readLessText;
            button.setAttribute('aria-expanded', 'true');
          }
        });
        
        const container = reviewBody.parentElement;
        if (container) {
          const existingButton = container.querySelector('.read-more-btn');
          if (!existingButton) {
            reviewBody.insertAdjacentElement('afterend', button);
          }
        }
      }
    }

    customElements.define('klaviyo-reviews-toggle-{{ ai_gen_id }}', KlaviyoReviewsToggle{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Klaviyo reviews toggle",
  "settings": [
    {
      "type": "header",
      "content": "Truncation"
    },
    {
      "type": "range",
      "id": "line_clamp",
      "label": "Lines to show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Button text"
    },
    {
      "type": "text",
      "id": "read_more_text",
      "label": "Read more text",
      "default": "Read more"
    },
    {
      "type": "text",
      "id": "read_less_text",
      "label": "Read less text",
      "default": "Read less"
    },
    {
      "type": "header",
      "content": "Button style"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Color",
      "default": "#020303"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "label": "Font size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "button_font_size_mobile",
      "label": "Mobile font size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "select",
      "id": "button_font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "select",
      "id": "button_text_decoration",
      "label": "Text decoration",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "underline",
          "label": "Underline"
        }
      ],
      "default": "underline"
    },
    {
      "type": "range",
      "id": "button_padding",
      "label": "Padding",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "button_margin_top",
      "label": "Top spacing",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Klaviyo reviews toggle"
    }
  ]
}
{% endschema %}
