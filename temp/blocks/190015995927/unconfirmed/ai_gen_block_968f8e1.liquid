{% doc %}
  @prompt
    help me create a banner that was portrait image in full page background  the animation zoom in to landscape zoom whole scroll down , the content could change the location and also size in mobile and desktop, font style too
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-zoom-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100vh;
    overflow: hidden;
    display: block;
  }

  .ai-zoom-banner-image-wrapper-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    z-index: -1;
  }

  .ai-zoom-banner-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform-origin: center center;
    transition: transform 0.1s ease-out;
  }

  .ai-zoom-banner-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-zoom-banner-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-zoom-banner-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-zoom-banner-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    padding: 40px 20px;
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .ai-zoom-banner-content-{{ ai_gen_id }} {
      justify-content: {{ block.settings.desktop_vertical_alignment }};
      align-items: {{ block.settings.desktop_horizontal_alignment }};
      text-align: {{ block.settings.desktop_text_alignment }};
    }
  }

  @media screen and (max-width: 749px) {
    .ai-zoom-banner-content-{{ ai_gen_id }} {
      justify-content: {{ block.settings.mobile_vertical_alignment }};
      align-items: {{ block.settings.mobile_horizontal_alignment }};
      text-align: {{ block.settings.mobile_text_alignment }};
    }
  }

  .ai-zoom-banner-heading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin: 0 0 20px;
    text-shadow: {{ block.settings.text_shadow_x }}px {{ block.settings.text_shadow_y }}px {{ block.settings.text_shadow_blur }}px {{ block.settings.text_shadow_color }};
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
  }

  {% if block.settings.heading_uppercase %}
    .ai-zoom-banner-heading-{{ ai_gen_id }} {
      text-transform: uppercase;
    }
  {% endif %}

  @media screen and (min-width: 750px) {
    .ai-zoom-banner-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_desktop }}px;
      line-height: {{ block.settings.heading_line_height_desktop }};
    }
  }

  @media screen and (max-width: 749px) {
    .ai-zoom-banner-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
      line-height: {{ block.settings.heading_line_height_mobile }};
    }
  }

  .ai-zoom-banner-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    margin: 0 0 30px;
    max-width: 600px;
    text-shadow: {{ block.settings.text_shadow_x }}px {{ block.settings.text_shadow_y }}px {{ block.settings.text_shadow_blur }}px {{ block.settings.text_shadow_color }};
    font-family: {{ block.settings.subheading_font.family }}, {{ block.settings.subheading_font.fallback_families }};
    font-weight: {{ block.settings.subheading_font.weight }};
    font-style: {{ block.settings.subheading_font.style }};
    letter-spacing: {{ block.settings.subheading_letter_spacing }}px;
  }

  {% if block.settings.subheading_uppercase %}
    .ai-zoom-banner-subheading-{{ ai_gen_id }} {
      text-transform: uppercase;
    }
  {% endif %}

  @media screen and (min-width: 750px) {
    .ai-zoom-banner-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_desktop }}px;
      line-height: {{ block.settings.subheading_line_height_desktop }};
    }
  }

  @media screen and (max-width: 749px) {
    .ai-zoom-banner-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_mobile }}px;
      line-height: {{ block.settings.subheading_line_height_mobile }};
    }
  }

  .ai-zoom-banner-button-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: background-color 0.3s ease;
    font-family: {{ block.settings.button_font.family }}, {{ block.settings.button_font.fallback_families }};
    font-weight: {{ block.settings.button_font.weight }};
    font-style: {{ block.settings.button_font.style }};
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
  }

  {% if block.settings.button_uppercase %}
    .ai-zoom-banner-button-{{ ai_gen_id }} {
      text-transform: uppercase;
    }
  {% endif %}

  @media screen and (min-width: 750px) {
    .ai-zoom-banner-button-{{ ai_gen_id }} {
      padding: {{ block.settings.button_padding_desktop }}px {{ block.settings.button_padding_desktop | times: 2 }}px;
      font-size: {{ block.settings.button_font_size_desktop }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-zoom-banner-button-{{ ai_gen_id }} {
      padding: {{ block.settings.button_padding_mobile }}px {{ block.settings.button_padding_mobile | times: 2 }}px;
      font-size: {{ block.settings.button_font_size_mobile }}px;
    }
  }

  .ai-zoom-banner-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-zoom-banner-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    pointer-events: none;
  }
{% endstyle %}

<zoom-banner-{{ ai_gen_id }}
  class="ai-zoom-banner-{{ ai_gen_id }}"
  data-zoom-start="{{ block.settings.zoom_start }}"
  data-zoom-end="{{ block.settings.zoom_end }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-zoom-banner-image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="eager"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
        class="ai-zoom-banner-image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-zoom-banner-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-zoom-banner-empty-state-{{ ai_gen_id }}">
          Next, add a portrait background image
        </div>
      </div>
    {% endif %}
    {% if block.settings.show_overlay %}
      <div class="ai-zoom-banner-overlay-{{ ai_gen_id }}"></div>
    {% endif %}
  </div>

  <div class="ai-zoom-banner-content-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h1 class="ai-zoom-banner-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <div class="ai-zoom-banner-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
    {% endif %}

    {% if block.settings.button_text != blank and block.settings.button_link != blank %}
      <a
        href="{{ block.settings.button_link }}"
        class="ai-zoom-banner-button-{{ ai_gen_id }}"
      >
        {{ block.settings.button_text }}
      </a>
    {% endif %}
  </div>
</zoom-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class ZoomBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.image = this.querySelector('.ai-zoom-banner-image-{{ ai_gen_id }}');
        this.zoomStart = parseFloat(this.dataset.zoomStart);
        this.zoomEnd = parseFloat(this.dataset.zoomEnd);
        this.handleScroll = this.handleScroll.bind(this);
      }

      connectedCallback() {
        if (!this.image) return;
        
        window.addEventListener('scroll', this.handleScroll);
        this.handleScroll();
      }

      disconnectedCallback() {
        window.removeEventListener('scroll', this.handleScroll);
      }

      handleScroll() {
        if (!this.image) return;

        const scrollPosition = window.scrollY;
        const windowHeight = window.innerHeight;
        const maxScroll = windowHeight;
        
        const scrollProgress = Math.min(scrollPosition / maxScroll, 1);
        
        const currentZoom = this.zoomStart + (this.zoomEnd - this.zoomStart) * scrollProgress;
        
        this.image.style.transform = 'scale(' + currentZoom + ')';
      }
    }

    customElements.define('zoom-banner-{{ ai_gen_id }}', ZoomBanner{{ ai_gen_id }});
  })();
</script>

