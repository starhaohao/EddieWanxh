{
  "sections": {
    "hero": {
      "type": "collection-image-with-title",
      "settings": {
        "show_title": true,
        "show_description": true,
        "flex_align": "align--bottom-left",
        "color_scheme": "scheme-06d8c44c-5174-4ce8-a30b-db9d0a78855e",
        "show_text_background": false,
        "overlay_type": "disabled",
        "show_image": false,
        "banner_layout": "overlay",
        "height": "two-fifty-height-hero",
        "mobile_height": "two-fifty-height-hero--mobile",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "clearance-strip": {
      "type": "landing-features-strip",
      "settings": {
        "bg_color": "#34070B",
        "border_color": "rgba(255,255,255,0.15)",
        "cat_color": "#CDFF00",
        "title_color": "#ffffff",
        "desc_color": "rgba(255,255,255,0.65)"
      },
      "blocks": {
        "feat-1": { "type": "feature", "settings": { "category": "Offer", "title": "Buy 5, Get 1 Free", "description": "Auto-applied at checkout. No code needed." } },
        "feat-2": { "type": "feature", "settings": { "category": "Stock", "title": "Final Sizes Only", "description": "Once sold out, they are gone." } },
        "feat-3": { "type": "feature", "settings": { "category": "Shipping", "title": "Free over $50", "description": "SG & MY. Free intl over $100." } },
        "feat-4": { "type": "feature", "settings": { "category": "Discount", "title": "Auto-Applied", "description": "No code. Combines with shipping discounts only." } }
      },
      "block_order": ["feat-1", "feat-2", "feat-3", "feat-4"]
    },
    "main": {
      "type": "collection",
      "custom_css": [
        ".product-item__image { border-radius: 0 !important; overflow: hidden; }",
        ".product-item__image img { border-radius: 0 !important; }",
        ".product-item__bg { border-radius: 0 !important; }",
        ".product-item__bg img { border-radius: 0 !important; }",
        ".card__media, .card__media img, .card-wrapper .media, .card-wrapper .media img, .product-card-wrapper .media, .product-card-wrapper .media img { border-radius: 0 !important; }"
      ],
      "settings": {
        "enable_sort": true,
        "enable_filters": true,
        "filter_layout": "inline-open",
        "default_open": true,
        "collection_linklist": "footer",
        "grid": 3,
        "grid_mobile": "2",
        "products_per_page": 24,
        "color_scheme": "scheme-06d8c44c-5174-4ce8-a30b-db9d0a78855e",
        "padding_top": 0,
        "padding_bottom": 60
      }
    },
    "section_recent_products": {
      "type": "section-recent-products",
      "name": "Recently viewed products",
      "settings": {
        "product_recently_limit": 10,
        "product_recently_minimum": 4,
        "product_recently_heading": "Viewed",
        "heading_font_size": "heading-mini",
        "layout_desktop": "slider",
        "grid": 3,
        "rows": 3,
        "layout_mobile": "slider",
        "color_scheme": "scheme-2",
        "padding_top": 30,
        "padding_bottom": 49,
        "heading_tag": "automatic"
      }
    }
  },
  "order": [
    "hero",
    "clearance-strip",
    "main",
    "section_recent_products"
  ]
}
