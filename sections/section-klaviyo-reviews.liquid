<!-- /sections/section-klaviyo-reviews.liquid -->

{%- comment -%}
  Embeds a Klaviyo Reviews widget in the same visual language as the
  "Social videos" section (grid__heading-holder heading block, badge-box
  rating badge in the same style as the collection page's sale badges,
  full-bleed edge-to-edge width option).

  This section only controls the OUTER wrapper — heading, badge, section
  padding/width/color scheme. The review cards themselves are rendered by
  Klaviyo's own widget script and can only be restyled from inside
  Klaviyo: Reviews > [widget] > Layout & style. See the schema info text
  on the "Widget" setting below for the remaining one-time setup steps in
  the Klaviyo dashboard (installation script + featuring reviews).
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  assign text = section.settings.text
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign widget_type = section.settings.widget_type
  assign has_content = false

  if heading != blank or text != blank or section.settings.rating_badge_text != blank
    assign has_content = true
  endif
-%}

{%- style -%}
  #KlaviyoReviews--{{ section.id }} {
    --PT: {{ section.settings.padding_top }}px;
    --PB: {{ section.settings.padding_bottom }}px;
  }

  /* Force true edge-to-edge breakout — .wrapper--full only spans the
     site's max content width, not the browser viewport. Same technique
     used in section-hero.liquid / section-social-videos.liquid. */
  #KlaviyoReviews--{{ section.id }} .grid-container.wrapper--full {
    width: 100vw !important;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw !important;
    margin-right: -50vw !important;
    max-width: 100vw !important;
  }

  #KlaviyoReviews--{{ section.id }} .grid__heading-holder {
    padding-left: var(--outer) !important;
    padding-right: var(--outer) !important;
  }
{%- endstyle -%}

<section
  id="KlaviyoReviews--{{ section.id }}"
  class="section-klaviyo-reviews section-padding {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="klaviyo-reviews"
>
  <div class="grid-container {{ section.settings.width }}">
    {%- if has_content -%}
      <div class="grid__heading-holder {{ section.settings.align_text }}">
        <div class="grid__heading-text">
          {%- if section.settings.rating_badge_text != blank -%}
            <span
              class="badge-box kr__rating-badge"
              style="--bg: {{ section.settings.badge_bg_color }}; --text: {{ section.settings.badge_text_color }};"
            >
              {{- section.settings.rating_badge_text -}}
            </span>
          {%- endif -%}

          {%- if heading != blank -%}
            <h2 class="grid__heading {{ section.settings.heading_font_size }}">
              {{- heading -}}
            </h2>
          {%- endif -%}

          {%- if text != blank -%}
            <div class="grid__text {{ section.settings.text_font_size }}">
              {{- text -}}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    <div class="kr__widget-holder" data-klaviyo-reviews-widget="{{ widget_type }}">
      {%- case widget_type -%}
        {%- when 'all_reviews' -%}
          <div id="klaviyo-reviews-all" data-id="all"></div>
        {%- else -%}
          <div id="klaviyo-featured-reviews-carousel"></div>
      {%- endcase -%}
    </div>
  </div>
</section>

<style>
  .kr__rating-badge {
    display: inline-flex;
    margin-bottom: 16px;
  }

  .kr__widget-holder {
    min-height: 40px;
  }
</style>

{% schema %}
{
  "name": "Klaviyo Reviews",
  "settings": [
    {
      "type": "header",
      "content": "Rating badge"
    },
    {
      "type": "text",
      "id": "rating_badge_text",
      "label": "Badge text",
      "default": "★★★★★ 4.9 · 200+ reviews",
      "info": "Klaviyo doesn't expose your live aggregate rating to Liquid, so this is set by hand — update it from Klaviyo's Reviews dashboard summary. Leave blank to hide."
    },
    {
      "type": "color",
      "id": "badge_bg_color",
      "label": "Badge background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by the community."
    },
    {
      "type": "select",
      "id": "heading_font_size",
      "label": "Heading size",
      "default": "heading-medium",
      "options": [
        {"value": "heading-mini", "label": "Mini"},
        {"value": "heading-x-small", "label": "Extra small"},
        {"value": "heading-small", "label": "Small"},
        {"value": "heading-medium", "label": "Medium"},
        {"value": "heading-large", "label": "Large"},
        {"value": "heading-x-large", "label": "Extra large"}
      ]
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Real reviews from real customers.</p>"
    },
    {
      "type": "select",
      "id": "text_font_size",
      "label": "Text size",
      "default": "body-medium",
      "options": [
        {"value": "body-x-small", "label": "Extra small"},
        {"value": "body-small", "label": "Small"},
        {"value": "body-medium", "label": "Medium"},
        {"value": "body-large", "label": "Large"},
        {"value": "body-x-large", "label": "Extra large"}
      ]
    },
    {
      "type": "select",
      "id": "align_text",
      "label": "Text alignment",
      "default": "text-center",
      "options": [
        {"value": "text-left", "label": "Left"},
        {"value": "text-center", "label": "Centered"}
      ]
    },
    {
      "type": "header",
      "content": "Widget"
    },
    {
      "type": "select",
      "id": "widget_type",
      "label": "Widget",
      "default": "featured_carousel",
      "options": [
        {"value": "featured_carousel", "label": "Featured review carousel"},
        {"value": "all_reviews", "label": "All reviews (SEO wall)"}
      ],
      "info": "Star rating, review summary, review list, and product reviews all require a specific product, so they belong on the product page (Klaviyo's own Product reviews widget block), not here.\n\nOne-time setup in Klaviyo, before this renders anything:\n1. Reviews > Settings > Installation — confirm the site script is installed (Shopify 2.0 stores usually have this on already).\n2. For the carousel: Reviews > All reviews, then click Feature next to each review you want shown here.\n3. Card colors/fonts/spacing are styled from inside Klaviyo, not this theme: open the widget, then Layout & style."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "default": "wrapper--full-padded",
      "options": [
        {"value": "wrapper--full", "label": "Full width"},
        {"value": "wrapper--full-padded", "label": "Full width padded"},
        {"value": "wrapper", "label": "Normal"}
      ]
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme_1",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "Bottom",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Klaviyo Reviews"
    }
  ],
  "disabled_on": {
    "groups": ["header", "aside", "footer"]
  },
  "templates": ["page", "index"]
}
{% endschema %}
