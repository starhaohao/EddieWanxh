{%- liquid
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign accent_color = section.settings.accent_color
-%}

<section class="sel-showcase" style="--sel-bg: {{ bg_color }}; --sel-text: {{ text_color }}; --sel-accent: {{ accent_color }};">
  <div class="sel-showcase__header">
    {%- if section.settings.eyebrow != blank -%}
      <p class="sel-showcase__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="sel-showcase__title">{{ section.settings.title }}</h2>
    {%- if section.settings.description != blank -%}
      <p class="sel-showcase__description">{{ section.settings.description }}</p>
    {%- endif -%}
  </div>

  <div class="sel-showcase__carousel">
    {%- for block in section.blocks -%}
      <div class="sel-showcase__card" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <div class="sel-showcase__image">
            <img src="{{ block.settings.image | image_url: width: 800 }}" alt="{{ block.settings.name | escape }}" loading="lazy">
          </div>
        {%- else -%}
          <div class="sel-showcase__image-placeholder"></div>
        {%- endif -%}
        <div class="sel-showcase__content">
          <h3 class="sel-showcase__name">{{ block.settings.name }}</h3>
          <p class="sel-showcase__subtitle">{{ block.settings.subtitle }}</p>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="sel-showcase__link">Learn more →</a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

<style>
  .sel-showcase {
    padding: 64px 40px;
    background: var(--sel-bg);
    color: var(--sel-text);
  }

  .sel-showcase__header {
    margin-bottom: 52px;
    max-width: 800px;
  }

  .sel-showcase__eyebrow {
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sel-accent);
    margin: 0 0 8px;
    font-weight: 500;
  }

  .sel-showcase__title {
    font-size: 42px;
    letter-spacing: -0.02em;
    line-height: 1.2;
    margin: 0 0 16px;
    font-weight: 600;
  }

  .sel-showcase__description {
    font-size: 16px;
    line-height: 1.6;
    opacity: 0.75;
    margin: 0;
  }

  .sel-showcase__carousel {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 8px;
  }

  .sel-showcase__card {
    scroll-snap-align: start;
    flex-shrink: 0;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 4px;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .sel-showcase__card:hover {
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-4px);
  }

  .sel-showcase__image {
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    background: #f0f0f0;
  }

  .sel-showcase__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .sel-showcase__card:hover .sel-showcase__image img {
    transform: scale(1.05);
  }

  .sel-showcase__image-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #e0e0e0 0%, #f0f0f0 100%);
  }

  .sel-showcase__content {
    padding: 20px;
  }

  .sel-showcase__name {
    font-size: 18px;
    font-weight: 600;
    margin: 0 0 6px;
    letter-spacing: -0.01em;
  }

  .sel-showcase__subtitle {
    font-size: 14px;
    opacity: 0.7;
    margin: 0 0 12px;
    line-height: 1.4;
  }

  .sel-showcase__link {
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sel-accent);
    text-decoration: none;
    font-weight: 500;
    display: inline-block;
    transition: opacity 0.2s ease;
  }

  .sel-showcase__link:hover {
    opacity: 0.8;
  }

  @media (max-width: 989px) {
    .sel-showcase {
      padding: 48px 24px;
    }

    .sel-showcase__title {
      font-size: 32px;
    }

    .sel-showcase__carousel {
      gap: 16px;
    }
  }

  @media (max-width: 749px) {
    .sel-showcase {
      padding: 40px 16px;
    }

    .sel-showcase__header {
      margin-bottom: 32px;
    }

    .sel-showcase__title {
      font-size: 24px;
    }

    .sel-showcase__carousel {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .sel-showcase__description {
      font-size: 14px;
    }
  }
</style>

{% schema %}
{
  "name": "Selection Showcase",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Our Selection"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Choose Your Style"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Explore our curated collection of premium essentials designed for your lifestyle.</p>"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#17191c"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#4a1024"
    }
  ],
  "blocks": [
    {
      "type": "selection_card",
      "name": "Selection Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Card image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Title",
          "default": "Premium Briefs"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Comfort meets style"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Selection Showcase",
      "blocks": [
        {
          "type": "selection_card",
          "settings": {
            "name": "Briefs",
            "subtitle": "Everyday essentials"
          }
        },
        {
          "type": "selection_card",
          "settings": {
            "name": "Boxer Trunks",
            "subtitle": "Modern comfort"
          }
        },
        {
          "type": "selection_card",
          "settings": {
            "name": "Tops",
            "subtitle": "Layering perfection"
          }
        }
      ]
    }
  ],
  "templates": ["page", "index"]
}
{% endschema %}
