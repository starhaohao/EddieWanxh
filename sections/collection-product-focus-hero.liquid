{% liquid
  assign color_scheme = 'color-' | append: section.settings.color_scheme
  assign eyebrow = section.settings.eyebrow
  assign title = collection.title
  assign tagline = section.settings.tagline
  assign description = collection.description
  assign intro = section.settings.intro
  assign cta_label = section.settings.cta_label
  assign cta_link = section.settings.cta_link
  assign accent_label = section.settings.accent_label
  assign use_collection_image = section.settings.use_collection_image
  assign image = section.settings.image

  if use_collection_image and collection.image != blank
    assign image = collection.image
  endif

  # Short per-collection description: prefer the merchant's manual
  # "Intro copy" override; otherwise pull from the collection's own
  # Collection Content metaobject (custom.collection_content) so the
  # copy differs per collection with no per-collection template
  # duplication; fall back to the native collection description.
  assign collection_content = collection.metafields.custom.collection_content.value
  if intro == blank and collection_content != blank
    if collection_content.about_design.value != blank
      assign intro = collection_content.about_design.value | newline_to_br
    elsif collection_content.about_fabric.value != blank
      assign intro = collection_content.about_fabric.value | newline_to_br
    endif
  endif
  if intro == blank
    assign intro = description
  endif
%}

<section
  class="pfh section-padding {{ color_scheme }}"
  data-section-id="{{ section.id }}"
  data-section-type="collection-product-focus-hero"
  style="--pfh-pt: {{ section.settings.padding_top }}px; --pfh-pb: {{ section.settings.padding_bottom }}px;"
>
  <div class="pfh__shell">
    <div class="pfh__intro">
      {% if eyebrow != blank %}
        <p class="pfh__eyebrow">{{ eyebrow }}</p>
      {% endif %}

      <div class="pfh__headline">
        <h1 class="pfh__title">{{ title }}</h1>

        {% if accent_label != blank %}
          <p class="pfh__accent">{{ accent_label }}</p>
        {% endif %}
      </div>

      {% if tagline != blank %}
        <p class="pfh__tagline">{{ tagline }}</p>
      {% endif %}

      {% if intro != blank %}
        <div class="pfh__copy rte">{{ intro }}</div>
      {% endif %}

      {% if cta_label != blank and cta_link != blank %}
        <a class="pfh__cta" href="{{ cta_link }}">{{ cta_label }}</a>
      {% endif %}
    </div>

    <div class="pfh__rail">
      {% if image != blank %}
        <div class="pfh__image-wrap">
          {{
            image
            | image_url: width: 1600
            | image_tag:
              class: 'pfh__image',
              widths: '600, 900, 1200, 1600',
              sizes: '(min-width: 990px) 32vw, 100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: title
          }}
        </div>
      {% endif %}

      {% assign has_links = false %}
      {% for block in section.blocks %}
        {% if block.settings.label != blank %}
          {% assign has_links = true %}
          {% break %}
        {% endif %}
      {% endfor %}

      {% if has_links %}
        <div class="pfh__panel">
          <div class="pfh__panel-head">
            <p class="pfh__panel-kicker">{{ section.settings.panel_label }}</p>
          </div>

          <div class="pfh__links">
            {% for block in section.blocks %}
              {% assign label = block.settings.label %}
              {% assign link = block.settings.link %}
              {% if label == blank %}
                {% continue %}
              {% endif %}

              <a
                class="pfh__link"
                href="{% if link != blank %}{{ link }}{% else %}{{ collection.url }}{% endif %}"
                {{ block.shopify_attributes }}
              >
                <span>{{ label }}</span>
              </a>
            {% endfor %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .pfh {
    padding: var(--pfh-pt) 0 var(--pfh-pb);
    background: rgb(var(--bg));
    color: rgb(var(--text));
  }

  .pfh a {
    color: inherit;
  }

  .pfh__shell {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(280px, 0.85fr);
    gap: 0;
    align-items: start;
  }

  .pfh__intro,
  .pfh__rail {
    min-width: 0;
  }

  .pfh__intro {
    padding: 28px var(--outer) 36px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 420px;
  }

  .pfh__eyebrow,
  .pfh__accent,
  .pfh__panel-kicker,
  .pfh__link {
    font-family: var(--FONT-STACK-NAV);
    font-size: max(11px, var(--font-body-x-small));
    line-height: 1.2;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .pfh__eyebrow,
  .pfh__panel-kicker {
    margin: 0 0 18px;
    opacity: 0.68;
  }

  .pfh__headline {
    display: grid;
    gap: 18px;
  }

  .pfh__title {
    font-family: var(--FONT-STACK-HEADING);
    margin: 0;
    max-width: 10ch;
    font-size: clamp(2.4rem, 6vw, max(5rem, var(--font-heading-large)));
    line-height: 0.95;
    letter-spacing: -0.04em;
    text-transform: uppercase;
  }

  .pfh__accent {
    margin: 0;
    opacity: 0.8;
  }

  .pfh__tagline {
    font-family: var(--FONT-STACK-NAV);
    margin: 14px 0 0;
    font-size: max(11px, var(--font-body-x-small));
    line-height: 1.2;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-variant-caps: small-caps;
    opacity: 0.68;
  }

  .pfh__copy {
    font-family: var(--FONT-STACK-BODY);
    margin-top: 28px;
    max-width: 52ch;
    font-size: var(--font-body-medium);
    line-height: 1.65;
    color: rgba(var(--text), 0.78);
  }

  .pfh__copy p {
    margin: 0;
  }

  .pfh__cta {
    font-family: var(--BTN-FONT-STACK);
    font-size: var(--font-body-x-small);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-width: 154px;
    margin-top: 30px;
    padding: 12px 18px;
    border: 1px solid rgba(var(--text), 0.28);
    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease;
  }

  .pfh__cta:hover {
    background: rgb(var(--text));
    color: rgb(var(--bg));
    border-color: rgb(var(--text));
  }

  .pfh__rail {
    display: grid;
    grid-template-rows: auto auto;
    border-left: 1px solid rgba(var(--text), 0.18);
  }

  .pfh__image-wrap {
    aspect-ratio: 1350 / 1080;
    background: rgba(var(--text), 0.06);
  }

  .pfh__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pfh__panel {
    border-top: 1px solid rgba(var(--text), 0.18);
    padding: 20px var(--outer) 22px;
  }

  .pfh__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 14px;
  }

  .pfh__link {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 12px;
    border: 1px solid rgba(var(--text), 0.16);
    text-decoration: none;
    opacity: 0.88;
    transition: opacity 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .pfh__link:hover {
    opacity: 1;
    border-color: rgba(var(--text), 0.5);
    transform: translateY(-1px);
  }

  /* Desktop only: the image rail breaks the page's side margin and
     bleeds to the true browser edge, while .pfh__intro (the text
     column) stays inset at the normal --outer gutter. Standard
     one-sided breakout: pull the element's right edge out by half the
     gap between the viewport and its containing block. */
  @media screen and (min-width: 990px) {
    .pfh__rail {
      margin-right: calc(-1 * (100vw - 100%) / 2);
    }
  }

  @media screen and (max-width: 989px) {
    .pfh__shell {
      grid-template-columns: minmax(0, 1fr);
    }

    .pfh__intro {
      min-height: auto;
      padding-top: 22px;
      padding-bottom: 24px;
    }

    .pfh__title {
      max-width: none;
      font-size: clamp(2.3rem, 13vw, 4rem);
    }

    .pfh__rail {
      border-left: 0;
      border-top: 1px solid rgba(var(--bg), 0.18);
    }

  }
</style>

{% schema %}
{
  "name": "Collection Focus Hero",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Collection"
    },
    {
      "type": "text",
      "id": "accent_label",
      "label": "Accent label",
      "default": "Product Focus Layout"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "WEAR IT. OWN. EXPLAIN NOTHING."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro copy override",
      "info": "Leave blank to pull the description automatically from the collection's Collection Content metafield (custom.collection_content), so copy differs per collection with no manual duplication."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Shop the edit"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    },
    {
      "type": "checkbox",
      "id": "use_collection_image",
      "label": "Use collection image",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Override image"
    },
    {
      "type": "text",
      "id": "panel_label",
      "label": "Links panel label",
      "default": "Browse"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "nav_link",
      "name": "Navigation link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Shop All"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Collection Focus Hero"
    }
  ]
}
{% endschema %}
