    .teh__community-grid { padding-inline: 20px; scroll-padding-inline: 20px; }
    .teh__community-item { flex-basis: 78vw; }

  }

  .teh__feature-eyebrow { position: absolute; z-index: 2; top: 28px; left: clamp(22px, 4vw, 64px); margin: 0; text-shadow: 0 2px 18px rgba(0,0,0,.6); }
  .teh__feature-description { margin: 0 0 24px; max-width: 560px; font-size: 14px; line-height: 1.6; }
  @media screen and (max-width: 767px) {
    .teh__story { display: flex; flex-direction: column; min-height: 0; gap: 0; }
    .teh__story-detail { aspect-ratio: 4 / 5; }
    .teh__story-form { min-height: 0; width: 100%; }
    .teh__story-form > .teh__image { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
    .teh__story-copy { position: static; width: 100%; max-width: none; padding: 24px 20px 32px; margin: 0; }
    .teh__story-copy p { max-width: none; margin: 16px 0 24px; }
    .teh__feature { display: flex; flex-direction: column; justify-content: space-between; min-height: 125vw; padding: 20px; gap: 48px; isolation: isolate; }
    .teh__feature > .teh__image { position: absolute; inset: 0; height: 100%; width: 100%; z-index: -2; }
    .teh__feature::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg, rgba(0,0,0,.3), transparent 35%, rgba(0,0,0,.6)); pointer-events: none; }
    .teh__feature .teh__feature-eyebrow { position: static; margin: 0; }
    body .teh__feature .teh__feature-copy { position: static; inset: auto; width: 100%; max-width: none; padding: 0; }
    .teh__feature-copy h2 { margin-bottom: 16px; }
    .teh__feature-description { max-width: none; margin-bottom: 24px; }
    .teh__community .teh__section-head { padding-inline: 20px; }
  }
  .teh__salon { position: relative; display: block; background: #000; color: #fff; }
  .teh__salon-track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
  .teh__salon-track::-webkit-scrollbar { display: none; }
  .teh__salon-slide { flex: 0 0 100%; width: 100%; min-width: 0; scroll-snap-align: start; scroll-snap-stop: always; isolation: isolate; }
  .teh__salon-slide > .teh__image { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -2; }
  .teh__salon-slide::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(180deg,rgba(0,0,0,.25),transparent 35%,rgba(0,0,0,.65)); pointer-events: none; }
  .teh__salon-controls { position: absolute; z-index: 3; bottom: 12px; left: 50%; transform: translateX(-50%); display: flex; justify-content: center; gap: 0; padding: 0; filter: drop-shadow(0 1px 3px rgba(0,0,0,.8)); }
  @media screen and (max-width: 767px) { .teh__salon-slide { padding-bottom: 76px; } }
  .teh__salon-controls button { position: relative; display: grid; place-items: center; flex: 0 0 28px; width: 28px; height: 44px; padding: 0; border: 0; border-radius: 50%; background: transparent; color: #fff; cursor: pointer; }
  .teh__salon-controls button span { display: block; width: 6px; height: 6px; border-radius: 50%; background: #fff; opacity: .5; transition: opacity 180ms ease; }
  .teh__salon-controls button::after { content: ''; position: absolute; top: 50%; left: 50%; width: 12px; height: 12px; box-sizing: border-box; transform: translate(-50%, -50%); border: 1px solid #fff; border-radius: 50%; opacity: 0; transition: opacity 180ms ease; }
  .teh__salon-controls button[aria-current='true'] span, .teh__salon-controls button[aria-current='true']::after { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .teh__salon-controls button span, .teh__salon-controls button::after { transition: none; } }
  .teh__salon-controls button:focus-visible, .teh__salon-track:focus-visible { outline: 2px solid #ff8a57; outline-offset: -2px; }
  @media screen and (max-width: 767px) { .teh__salon-slide { box-sizing: border-box; } }

  .teh__community-grid { scrollbar-color: rgba(255,255,255,.38) transparent; }
  .teh__community-grid::-webkit-scrollbar { height: 6px; background: transparent; }
  .teh__community-grid::-webkit-scrollbar-track { background: transparent; }
  .teh__community-grid::-webkit-scrollbar-thumb { background: rgba(255,255,255,.38); border-radius: 999px; }
  @media screen and (max-width: 767px) {
    .teh__craft { grid-template-columns: 1fr; }
