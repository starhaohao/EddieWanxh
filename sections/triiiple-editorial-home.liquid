    .teh__craft-media > .teh__image, .teh__craft-media > .teh__craft-asset { position: absolute; inset: 0; width: 100%; height: 100%; min-height: 0; object-fit: cover; }
  }

  @media screen and (max-width: 767px) {
    .teh__salon-slide { aspect-ratio: 1080 / 1550; min-height: 0; }
    .teh__edit .teh__section-head { padding-inline: 20px; }
    .teh__edit-notes { flex-direction: column; padding-inline: 20px; }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('triiiple-story-carousel')) {
    customElements.define('triiiple-story-carousel', class extends HTMLElement {
      connectedCallback() {
        this.abortController = new AbortController();
        const options = { signal: this.abortController.signal };
        const track = this.querySelector('.teh__salon-track');
        const slides = Array.from(this.querySelectorAll('[data-salon-slide]'));
        const buttons = Array.from(this.querySelectorAll('[data-salon-index]'));
        if (!track || !slides.length) return;
        const current = () => Math.round(track.scrollLeft / track.clientWidth);
        const go = (index) => {
          const target = (index + slides.length) % slides.length;
          track.scrollTo({ left: target * track.clientWidth, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        };
        this.addEventListener('click', (event) => {
          const button = event.target.closest('button');
          if (!button || !this.contains(button)) return;
          if (button.hasAttribute('data-salon-index')) go(Number(button.dataset.salonIndex));
          if (button.hasAttribute('data-salon-step')) go(current() + Number(button.dataset.salonStep));
        }, options);
        track.addEventListener('keydown', (event) => {
          if (event.target !== track) return;
          if (event.key === 'ArrowRight' || event.key === 'ArrowLeft') {
            event.preventDefault(); go(current() + (event.key === 'ArrowRight' ? 1 : -1));
          }
        }, options);
        track.addEventListener('scroll', () => {
          buttons.forEach((button, index) => {
            if (index === current()) button.setAttribute('aria-current', 'true');
            else button.removeAttribute('aria-current');
          });
        }, { ...options, passive: true });
        this.addEventListener('shopify:block:select', (event) => {
          const index = slides.indexOf(event.target.closest('[data-salon-slide]'));
          if (index >= 0) go(index);
        }, options);
      }
      disconnectedCallback() { this.abortController?.abort(); }
    });
  }
{% endjavascript %}

