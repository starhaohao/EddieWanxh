  .teh__craft-copy { display: flex; flex-direction: column; justify-content: center; padding: clamp(44px, 7vw, 110px); }
  .teh__community-grid { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x proximity; scroll-behavior: smooth; scroll-padding-inline: 32px; padding: 0 32px 16px; scrollbar-width: thin; }
