{%- liquid
  assign hero_left = section.settings.hero_left_product
  assign hero_right = section.settings.hero_right_product
  assign hero_left_image = section.settings.hero_left_image
  assign hero_right_image = section.settings.hero_right_image
  if hero_left_image == blank
    assign hero_left_image = hero_left.featured_image
  endif
  if hero_right_image == blank
    assign hero_right_image = hero_right.featured_image
  endif
  assign hero_left_link = section.settings.hero_left_link | default: hero_left.url
  assign hero_right_link = section.settings.hero_right_link | default: hero_right.url | default: section.settings.limited_collection.url
  assign limited_drop = section.settings.limited_collection
  assign feature_image = section.settings.feature_image
  if feature_image == blank
    assign feature_image = limited_drop.products.first.featured_image
  endif
  assign feature_link = section.settings.feature_link
  if feature_link == blank and section.settings.feature_page != blank
    assign feature_link = section.settings.feature_page.url
  endif
  if feature_link == blank
    assign feature_link = limited_drop.url
  endif
  assign salon_entry = section.settings.salon_entry
  if salon_entry == blank
    assign salon_entry = metaobjects.story_salon['with-justin-foo']
  endif
  assign salon_heading = section.settings.drop_heading
  assign salon_description = section.settings.feature_description
  assign craft_heading = section.settings.craft_heading
  assign craft_body = section.settings.craft_body
  assign craft_link = section.settings.craft_link | default: section.settings.story_page.url
  if salon_entry != blank
    assign salon_heading = salon_heading | default: salon_entry.tagline.value
    assign salon_description = salon_description | default: salon_entry.theme.value
    assign craft_heading = craft_heading | default: salon_entry.name.value
    assign craft_body = craft_body | default: salon_entry.pull_quote.value
    assign salon_url = salon_entry.blog_post.value.url | default: salon_entry.page.value.url | default: salon_entry.system.url
    assign feature_link = feature_link | default: salon_url
    assign craft_link = craft_link | default: salon_url
    if feature_image == blank
      assign feature_image = salon_entry.hero_image.value
    endif
  endif
  assign story_product = section.settings.story_product
  assign craft_product = section.settings.craft_product
  assign story_left_image = section.settings.story_left_image | default: story_product.media[1].preview_image | default: story_product.featured_image
  assign story_right_image = section.settings.story_right_image | default: story_product.featured_image
  assign salon_slides = section.blocks | where: 'type', 'salon_slide'
  assign story_heading = section.settings.story_heading
  assign story_body = section.settings.story_body
  assign story_link = section.settings.essentials_collection.url
  if story_product != blank
    assign story_link = story_product.url
    if section.settings.story_use_product_content
      assign story_heading = story_product.metafields.custom.display_name.value | default: story_product.title
      assign story_body = story_product.description | strip_html | strip | truncate: 220
    endif
  endif
-%}

{%- liquid
  assign display_part = section.settings.display_part | default: 'all'
  assign show_top = true
  assign show_bottom = true
  if display_part == 'top'
    assign show_bottom = false
  elsif display_part == 'bottom'
    assign show_top = false
  endif
-%}

{%- capture action_arrow -%}
  <svg class="teh__action-arrow" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false"><path d="M3 10h13M11 5l5 5-5 5" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke"/></svg>
{%- endcapture -%}

<div class="teh">

  {%- if show_top -%}
  <section class="teh__hero">
    <div class="teh__hero-panel teh__hero-panel--left">
      {%- if hero_left_image != blank -%}
        {{ hero_left_image | image_url: width: 1350 | image_tag: widths: '540, 720, 900, 1080, 1350', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'eager', fetchpriority: 'high', class: 'teh__image' }}
      {%- endif -%}
      <div class="teh__panel-copy">
        <h1>{{ section.settings.hero_left_heading }}</h1>
        {%- if hero_left_link != blank -%}
          <a class="teh__button teh__button--light" href="{{ hero_left_link }}">{{ section.settings.hero_left_cta }}</a>
        {%- endif -%}
      </div>
    </div>
    <div class="teh__hero-panel teh__hero-panel--right">
      {%- if hero_right_image != blank -%}
        {{ hero_right_image | image_url: width: 1350 | image_tag: widths: '540, 720, 900, 1080, 1350', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'eager', fetchpriority: 'high', class: 'teh__image' }}
      {%- endif -%}
      <div class="teh__panel-copy teh__panel-copy--limited">
        <h2>{{ section.settings.hero_right_heading }}</h2>
        {%- if hero_right_link != blank -%}
          <a class="teh__button teh__button--light" href="{{ hero_right_link }}">{{ section.settings.hero_right_cta }}</a>
        {%- endif -%}
      </div>
    </div>
  </section>

  <section class="teh__action">
    <h2>{{ section.settings.action_heading }}</h2>
    <div class="teh__action-grid">
      <a class="teh__action-button" style="--action-link-color: {{ section.settings.action_color_1 | default: '#2a2a2a' }};" href="{{ section.settings.action_collection_1.url }}"><span>{{ section.settings.action_label_1 | escape }}</span>{{ action_arrow }}</a>
      <a class="teh__action-button" style="--action-link-color: {{ section.settings.action_color_2 | default: '#2a2a2a' }};" href="{{ section.settings.action_url_2 | default: section.settings.action_collection_2.url }}"><span>{{ section.settings.action_label_2 | escape }}</span>{{ action_arrow }}</a>
      <a class="teh__action-button" style="--action-link-color: {{ section.settings.action_color_3 | default: '#2a2a2a' }};" href="{{ section.settings.action_collection_3.url }}"><span>{{ section.settings.action_label_3 | escape }}</span>{{ action_arrow }}</a>
      <a class="teh__action-button" style="--action-link-color: {{ section.settings.action_color_4 | default: '#ff5a1f' }};" href="{{ section.settings.action_collection_4.url }}"><span>{{ section.settings.action_label_4 | escape }}</span>{{ action_arrow }}</a>
    </div>
  </section>

  <section class="teh__categories">
    <div class="teh__section-head">
      <h2>{{ section.settings.category_heading }}</h2>
      <a class="teh__view-all teh__text-action" style="--action-link-color: {{ section.settings.category_link_color | default: '#2a2a2a' }};" href="{{ section.settings.showcase_collection.url }}"><span>{{ section.settings.category_view_all | escape }}</span>{{ action_arrow }}</a>
    </div>
    <div class="teh__category-track">
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          {%- assign card_collection = block.settings.collection -%}
          <a class="teh__category-card" href="{{ card_collection.url }}" {{ block.shopify_attributes }}>
            <div class="teh__media">
              {%- if block.settings.product != blank and block.settings.product.featured_image != blank -%}
                {{ block.settings.product.featured_image | image_url: width: 1200 | image_tag: widths: '420, 640, 900, 1200', sizes: '(min-width: 750px) 33vw, 82vw', loading: 'lazy', class: 'teh__image' }}
              {%- elsif card_collection.image != blank -%}
                {{ card_collection.image | image_url: width: 1200 | image_tag: widths: '420, 640, 900, 1200', sizes: '(min-width: 750px) 33vw, 82vw', loading: 'lazy', class: 'teh__image' }}
              {%- endif -%}
            </div>
            <span>{{ block.settings.label | default: card_collection.title | escape }}</span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
  {%- endif -%}

  {%- if show_bottom -%}
  <section class="teh__story">
    <div class="teh__story-detail">
      {%- if story_left_image != blank -%}
        {{ story_left_image | image_url: width: 1200 | image_tag: widths: '500, 800, 1000, 1200', sizes: '(min-width: 750px) 40vw, 100vw', loading: 'lazy', class: 'teh__image' }}
      {%- endif -%}
    </div>
    <div class="teh__story-form">
      {%- if story_right_image != blank -%}
        {{ story_right_image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 750px) 60vw, 100vw', loading: 'lazy', class: 'teh__image' }}
      {%- endif -%}
      <div class="teh__story-copy">
        <h2>{{ story_heading | escape }}</h2>
        <p>{{ story_body | escape }}</p>
        <a class="teh__button teh__button--light" href="{{ story_link }}">{{ section.settings.story_cta }}</a>
      </div>
    </div>
  </section>

  {%- if salon_slides.size > 0 -%}
    <triiiple-story-carousel class="teh__salon" aria-label="{{ section.settings.drop_eyebrow | escape }}">
      <div class="teh__salon-track" id="SalonTrack-{{ section.id }}" tabindex="0" role="region" aria-label="{{ section.settings.drop_eyebrow | escape }}">
        {%- for block in salon_slides -%}
          {%- liquid
            assign slide_image = block.settings.image | default: block.settings.article.image
            assign slide_title = block.settings.heading | default: block.settings.article.title | default: block.settings.page.title
            assign slide_link = block.settings.link | default: block.settings.page.url | default: block.settings.article.url
          -%}
          <section class="teh__feature teh__salon-slide" data-salon-slide aria-label="{{ forloop.index }} / {{ forloop.length }} — {{ slide_title | escape }}" {{ block.shopify_attributes }}>
            {%- if slide_image != blank -%}
              {{ slide_image | image_url: width: 2400 | image_tag: widths: '540, 800, 1200, 1600, 2000, 2400', sizes: '100vw', loading: 'lazy', class: 'teh__image' }}
            {%- endif -%}
            <p class="teh__eyebrow teh__feature-eyebrow">{{ block.settings.eyebrow | default: section.settings.drop_eyebrow | escape }}</p>
            <div class="teh__feature-copy">
              <h2>{{ slide_title | escape }}</h2>
              {%- if block.settings.description != blank -%}<p class="teh__feature-description">{{ block.settings.description | escape | newline_to_br }}</p>{%- endif -%}
              {%- if slide_link != blank -%}<a class="teh__button teh__button--light" href="{{ slide_link }}">{{ block.settings.button_label | escape }}</a>{%- endif -%}
            </div>
          </section>
        {%- endfor -%}
      </div>
      {%- if salon_slides.size > 1 -%}
        <div class="teh__salon-controls">
          {%- for block in salon_slides -%}
            <button type="button" data-salon-index="{{ forloop.index0 }}" aria-controls="SalonTrack-{{ section.id }}" aria-label="{{ block.settings.heading | default: block.settings.page.title | default: block.settings.article.title | escape }}" {% if forloop.first %}aria-current="true"{% endif %}><span aria-hidden="true"></span></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </triiiple-story-carousel>
  {%- else -%}
  <section class="teh__feature">
    {%- if feature_image != blank -%}
      {{ feature_image | image_url: width: 2400 | image_tag: widths: '800, 1200, 1600, 2000, 2400', sizes: '100vw', loading: 'lazy', class: 'teh__image' }}
    {%- endif -%}
    <p class="teh__eyebrow teh__feature-eyebrow">{{ section.settings.drop_eyebrow }}</p>
    <div class="teh__feature-copy">
      <h2>{{ salon_heading | escape }}</h2>
      {%- if salon_description != blank -%}
        <p class="teh__feature-description">{{ salon_description | escape | newline_to_br }}</p>
      {%- endif -%}
      {%- if feature_link != blank -%}
        <a class="teh__button teh__button--light" href="{{ feature_link }}">{{ section.settings.drop_cta }}</a>
      {%- endif -%}
    </div>
  </section>

  {%- endif -%}

  <section class="teh__edit">
    <div class="teh__section-head">
      <h2>{{ section.settings.edit_heading }}</h2>
    </div>
    {%- if section.settings.edit_supporting_line != blank or section.settings.edit_offer_text != blank -%}
      <div class="teh__edit-notes">
        {%- if section.settings.edit_supporting_line != blank -%}<p>{{ section.settings.edit_supporting_line | escape }}</p>{%- endif -%}
        {%- if section.settings.edit_offer_text != blank -%}<p class="teh__edit-offer" style="--action-link-color: {{ section.settings.edit_offer_color | default: '#ff8a57' }};">{% if section.settings.edit_offer_link != blank %}<a class="teh__text-action" href="{{ section.settings.edit_offer_link }}"><span>{{ section.settings.edit_offer_text | escape }}</span>{{ action_arrow }}</a>{% else %}{{ section.settings.edit_offer_text | escape }}{% endif %}</p>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="teh__product-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'product' and block.settings.product != blank -%}
          {%- assign featured_product = block.settings.product -%}
          <a class="teh__product" href="{{ featured_product.url }}" {{ block.shopify_attributes }}>
            <div class="teh__media">
              {{ featured_product.featured_image | image_url: width: 1000 | image_tag: widths: '360, 520, 760, 1000', sizes: '(min-width: 750px) 25vw, 50vw', loading: 'lazy', class: 'teh__image' }}
            </div>
            <div class="teh__product-meta">
              <span>{{ featured_product.metafields.custom.display_name.value | default: featured_product.title }}</span>
              {%- unless featured_product.available -%}<span class="teh__sold-out">SOLD OUT</span>{%- endunless -%}
              <span class="teh__prices">
                {%- if featured_product.compare_at_price > featured_product.price -%}
                  <s>{{ featured_product.compare_at_price | money_with_currency }}</s>
                {%- endif -%}
                <span>{{ featured_product.price | money_with_currency }}</span>
              </span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  <section class="teh__craft">
    <div class="teh__craft-media">
      {%- if section.settings.craft_video != blank -%}
        {{ section.settings.craft_video | video_tag: autoplay: true, loop: true, muted: true, controls: true, playsinline: true, class: 'teh__craft-asset' }}
      {%- elsif section.settings.craft_image != blank -%}
        {{ section.settings.craft_image | image_url: width: 1800 | image_tag: widths: '600, 900, 1200, 1600, 1800', sizes: '(min-width: 750px) 55vw, 100vw', loading: 'lazy', class: 'teh__image' }}
      {%- elsif craft_product != blank and craft_product.featured_image != blank -%}
        {{ craft_product.featured_image | image_url: width: 1600 | image_tag: widths: '600, 900, 1200, 1600', sizes: '(min-width: 750px) 55vw, 100vw', loading: 'lazy', class: 'teh__image' }}
      {%- endif -%}
    </div>
    <div class="teh__craft-copy">
      <h2>{{ craft_heading | escape }}</h2>
      <p>{{ craft_body | escape | newline_to_br }}</p>
      <a class="teh__button teh__button--dark" href="{{ craft_link }}">{{ section.settings.craft_cta }}</a>
    </div>
  </section>

  <section class="teh__community">
    <div class="teh__section-head">
      <h2>{{ section.settings.community_heading }}</h2>
      {%- if section.settings.instagram_url != blank -%}<a class="teh__view-all teh__text-action" style="--action-link-color: {{ section.settings.community_link_color | default: '#ffffff' }};" href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener"><span>{{ section.settings.community_follow_label | escape }}</span>{{ action_arrow }}</a>{%- endif -%}
    </div>
    {%- if section.settings.community_supporting_line != blank -%}<p class="teh__community-note">{{ section.settings.community_supporting_line | escape }}</p>{%- endif -%}
    <div class="teh__community-grid" tabindex="0" role="region" aria-label="{{ section.settings.community_heading | escape }}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'community' -%}
          {%- assign community_image = block.settings.image -%}
          {%- if community_image == blank and block.settings.product != blank -%}
            {%- assign community_image = block.settings.product.featured_image -%}
          {%- endif -%}
          {%- assign community_link = block.settings.link -%}
          {%- if community_link == blank and block.settings.image == blank and block.settings.product != blank -%}
            {%- assign community_link = block.settings.product.url -%}
          {%- endif -%}
          {%- assign community_link = community_link | default: section.settings.instagram_url -%}
          {%- if community_image != blank -%}
            <a href="{{ community_link }}" target="_blank" rel="noopener" class="teh__community-item" {{ block.shopify_attributes }}>
              {{ community_image | image_url: width: 1080 | image_tag: widths: '360, 540, 720, 900, 1080', sizes: '(min-width: 768px) 26vw, 78vw', loading: 'lazy', class: 'teh__image' }}
            </a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
  {%- endif -%}

</div>

{% stylesheet %}
  .teh { background: #000; color: #f4f4f0; }
  .teh * { box-sizing: border-box; }
  .teh__image { display: block; width: 100%; height: 100%; object-fit: cover; }
  .teh__hero { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); background: #080808; }
  .teh__hero-panel { position: relative; min-width: 0; aspect-ratio: 4 / 5; overflow: hidden; }
  .teh__hero-panel--left { border-right: 1px solid rgba(255,255,255,.3); }
  .teh__panel-copy { position: absolute; z-index: 2; inset: 28px 28px auto; display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; color: #fff; text-shadow: 0 2px 18px rgba(0,0,0,.55); }
  .teh__panel-copy h1, .teh__panel-copy h2 { max-width: 320px; margin: 0; font-size: clamp(18px, 1.65vw, 28px); line-height: 1.15; font-weight: 400; letter-spacing: .01em; }
  .teh__panel-copy--limited h2 { color: #ff5a1f; }
  .teh__eyebrow { margin: 0 0 12px; font-size: 11px; line-height: 1.2; letter-spacing: .13em; text-transform: uppercase; }
  .teh h1, .teh h2, .teh p { color: inherit; }
  .teh h1 { max-width: 760px; margin: 0 0 24px; font-size: clamp(28px, 4vw, 58px); line-height: 1.05; font-weight: 400; letter-spacing: 0; }
  .teh h2 { margin: 0; font-size: clamp(24px, 2.7vw, 42px); line-height: 1.12; font-weight: 400; letter-spacing: .005em; }
  .teh__button { display: inline-flex; align-items: center; min-height: 42px; padding: 0 18px; border: 1px solid currentColor; font-size: 11px; letter-spacing: .08em; text-transform: uppercase; text-decoration: none; transition: background-color .2s ease, color .2s ease; }
  .teh__button--light { color: #fff; }
  .teh__button--light:hover { background: #fff; color: #000; }
  .teh__button--dark { color: #000; }
  .teh__button--dark:hover { background: #000; color: #fff; }
  .teh__action { display: flex; min-height: clamp(420px, 62vh, 720px); flex-direction: column; align-items: center; justify-content: center; padding: 72px 32px; background: #fff; color: #2a2a2a; text-align: center; }
  .teh__action h2 { margin-bottom: 48px; font-size: clamp(22px, 2.35vw, 34px); font-weight: 400; letter-spacing: .01em; }
  .teh__action-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 220px)); justify-content: center; gap: 14px; }
  .teh__action-button { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 48px; padding: 10px 16px; border: 1px solid var(--action-link-color, #2a2a2a); color: var(--action-link-color, #2a2a2a); font-size: 11px; line-height: 1.25; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; transition: background-color .2s ease, color .2s ease; }
  .teh__action-button:hover { background: var(--action-link-color, #2a2a2a); color: #fff; }
  /* Arrows pinned to the same right edge on every button; labels stay centred. */
  .teh__action-button { position: relative; padding-left: 44px; padding-right: 44px; }
  .teh__action-button .teh__action-arrow { position: absolute; top: 50%; right: 16px; transform: translateY(-50%); }
  .teh__categories { padding-bottom: 84px; background: #efefed; color: #2a2a2a; }
  .teh__section-head { display: flex; align-items: end; justify-content: space-between; padding: 26px 32px 20px; border-top: 1px solid rgba(255,255,255,.22); }
  .teh__categories .teh__section-head { padding-top: 42px; border-top: 0; }
  .teh__categories .teh__section-head h2 { font-size: clamp(21px, 2.1vw, 30px); font-weight: 400; }
  .teh__view-all { color: inherit; font-size: 12px; text-underline-offset: 4px; }
  .teh .teh__text-action { display: inline-flex; align-items: center; gap: 8px; color: var(--action-link-color, inherit); font-weight: 400; }
  .teh__action-arrow { display: block; width: 18px; height: 18px; flex: 0 0 18px; }
  .teh__text-action:focus-visible, .teh__action-button:focus-visible { outline: 1px solid currentColor; outline-offset: 4px; }
  .teh__category-track { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; padding: 0 32px; }
  .teh__category-card { min-width: 0; color: #000; text-decoration: none; }
  .teh__category-card .teh__media { aspect-ratio: 4 / 5; overflow: hidden; }
  .teh__category-card span { display: block; padding: 14px 0 0; font-size: 12px; line-height: 1.35; }
  .teh__category-card .teh__image, .teh__product .teh__image { transition: transform .5s ease; }
  .teh__category-card:hover .teh__image, .teh__product:hover .teh__image { transform: scale(1.025); }
  .teh__feature { position: relative; min-height: 76vh; overflow: hidden; }
  .teh__feature-copy { position: absolute; left: clamp(22px, 4vw, 64px); bottom: clamp(30px, 6vw, 80px); max-width: 680px; text-shadow: 0 2px 24px rgba(0,0,0,.6); }
  .teh__feature-copy h2 { max-width: 560px; margin-bottom: 28px; font-size: clamp(26px, 3vw, 44px); }
  .teh__story { display: grid; grid-template-columns: 2fr 3fr; min-height: 720px; }
  .teh__story-detail, .teh__story-form { min-width: 0; overflow: hidden; }
  .teh__story-form { position: relative; }
  .teh__story-copy { position: absolute; left: 40px; right: 40px; bottom: 40px; max-width: 620px; }
  .teh__story-copy p, .teh__craft-copy p { max-width: 540px; margin: 18px 0 24px; font-size: 14px; line-height: 1.65; }
  .teh__edit { background: #000; }
  .teh__edit-notes { display: flex; justify-content: space-between; gap: 12px 32px; padding: 0 32px 22px; font-size: 12px; line-height: 1.5; }
  .teh__edit-notes p, .teh__community-note { margin: 0; }
  .teh .teh__edit-offer { color: var(--action-link-color, #ff8a57); }
  .teh__community-note { padding: 0 32px 20px; font-size: 12px; line-height: 1.5; }
  .teh__product-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .teh__product { color: #fff; text-decoration: none; border-right: 1px solid rgba(255,255,255,.18); }
  .teh__product .teh__media { aspect-ratio: 3 / 4; overflow: hidden; background: #111; }
  .teh__product-meta { display: flex; justify-content: space-between; gap: 14px; padding: 14px 16px 24px; font-size: 11px; line-height: 1.35; text-transform: uppercase; }
  .teh__prices { display: flex; justify-content: flex-end; gap: 8px; white-space: nowrap; }
