{%- comment -%}
  PDP anchor navigation + uploadable media (image OR video).
  A horizontal row of hairline-separated text links that smooth-scroll to
  page anchors, above a full-width merchant-uploadable image OR video.
  Media picker supports:
    • Shopify-hosted video (native <video>, autoplay-muted-loop by default)
    • External video URL (YouTube / Vimeo, embedded via <iframe>)
    • Static image (existing behaviour)
  Sits between the product buy area and the Product detail story section.
  Anchor targets default to the ids added on that section
  (product-details / product-why / product-size-guide) and are editable
  per nav item in the theme editor.
  Quiet-luxury system: #FFFFFF bg, #1D1D1F text, #E5E5E5 hairlines.
{%- endcomment -%}

{%- liquid
  assign pan_sticky = section.settings.sticky_enabled
  assign pan_has_nav = false
  for block in section.blocks
    if block.type == 'link' and block.settings.label != blank
      assign pan_has_nav = true
    endif
  endfor

  # ── Resolve which media to render ──
  # Priority: video (Shopify-hosted) → video_url (YouTube/Vimeo) → image.
  # `media_type` in the schema forces a specific slot; blank = auto.
  assign pan_media_type = section.settings.media_type
  assign pan_has_video = false
  assign pan_has_video_url = false
  assign pan_has_image = false
  if section.settings.video != blank
    assign pan_has_video = true
  endif
  if section.settings.video_url != blank
    assign pan_has_video_url = true
  endif
  if section.settings.image != blank
    assign pan_has_image = true
  endif
  assign pan_media = 'none'
  if pan_media_type == 'video' and pan_has_video
    assign pan_media = 'video'
  elsif pan_media_type == 'video_url' and pan_has_video_url
    assign pan_media = 'video_url'
  elsif pan_media_type == 'image' and pan_has_image
    assign pan_media = 'image'
  else
    if pan_has_video
      assign pan_media = 'video'
    elsif pan_has_video_url
      assign pan_media = 'video_url'
    elsif pan_has_image
      assign pan_media = 'image'
    endif
  endif

  # Resolve the product-family reel through the dedicated snippet.
  capture pan_product_video_url
    render 'pdp-product-video-snippet', product: product
  endcapture
  assign pan_product_video_url = pan_product_video_url | strip
  assign pan_product_video_alt = product.title | append: ' product video'

  if pan_product_video_url != blank
    assign pan_media = 'product_video'
  endif
-%}

<section class="pan" data-pdp-anchor-nav>
  {%- if pan_has_nav -%}
    <nav
      class="pan__nav{% if pan_sticky %} pan__nav--sticky{% endif %}"
      aria-label="{{ section.settings.nav_aria_label | escape }}"
    >
      <ul class="pan__list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'link' and block.settings.label != blank -%}
            {%- assign pan_target = block.settings.anchor | strip | remove: '#' -%}
            <li class="pan__item" {{ block.shopify_attributes }}>
              <a class="pan__link" href="#{{ pan_target }}" data-pdp-anchor-link>{{ block.settings.label | escape }}</a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>
  {%- endif -%}

  {%- case pan_media -%}
    {%- when 'product_video' -%}
      <div class="pan__media pan__media--video pan__media--product-video">
        <video
          data-pan-video
          autoplay
          muted
          playsinline
          loop
          preload="metadata"
          aria-label="{{ pan_product_video_alt | escape }}"
        >
          <source src="{{ pan_product_video_url }}" type="video/mp4">
        </video>
      </div>

    {%- when 'video' -%}
      {%- comment -%} Shopify-hosted video: <video> with all sources. Autoplay
        requires `muted` + `playsinline`. `loading` on <video> isn't
        universally supported, so we lazy-load via IntersectionObserver in
        the script below. {%- endcomment -%}
      <div class="pan__media pan__media--video">
        <video
          data-pan-video
          {% if section.settings.video_autoplay %}autoplay muted playsinline{% endif %}
          {% if section.settings.video_loop %}loop{% endif %}
          {% if section.settings.video_muted %}muted{% endif %}
          {% if section.settings.video_controls %}controls{% endif %}
          preload="metadata"
          {%- if section.settings.video.preview_image != blank %} poster="{{ section.settings.video.preview_image | image_url: width: 2400 }}"{% endif %}
        >
          {%- for source in section.settings.video.sources -%}
            <source src="{{ source.url }}" type="{{ source.mime_type }}">
          {%- endfor -%}
        </video>
      </div>

    {%- when 'video_url' -%}
      {%- comment -%} External video URL (YouTube / Vimeo). Embed via <iframe>
        so the browser gets the correct player. Query params keep the embed
        minimal and enable autoplay-muted-loop when the merchant asked
        for it. {%- endcomment -%}
      {%- assign pan_vid_id = section.settings.video_url.id -%}
      {%- if section.settings.video_url.type == 'youtube' -%}
        {%- assign pan_yt_qs = 'autoplay=0&mute=0&controls=1&modestbranding=1&rel=0&playsinline=1' -%}
        {%- if section.settings.video_autoplay -%}{%- assign pan_yt_qs = 'autoplay=1&mute=1&controls=0&modestbranding=1&rel=0&playsinline=1&loop=1&playlist=' | append: pan_vid_id -%}{%- endif -%}
        <div class="pan__media pan__media--video pan__media--embed">
          <iframe
            data-pan-embed
            src="https://www.youtube.com/embed/{{ pan_vid_id }}?{{ pan_yt_qs }}"
            title="{{ section.settings.image_alt | default: 'Product video' | escape }}"
            frameborder="0"
            allow="autoplay; encrypted-media; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      {%- elsif section.settings.video_url.type == 'vimeo' -%}
        {%- assign pan_vm_qs = 'byline=0&title=0&portrait=0' -%}
        {%- if section.settings.video_autoplay -%}{%- assign pan_vm_qs = 'autoplay=1&muted=1&loop=1&background=1&byline=0&title=0&portrait=0' -%}{%- endif -%}
        <div class="pan__media pan__media--video pan__media--embed">
          <iframe
            data-pan-embed
            src="https://player.vimeo.com/video/{{ pan_vid_id }}?{{ pan_vm_qs }}"
            title="{{ section.settings.image_alt | default: 'Product video' | escape }}"
            frameborder="0"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      {%- endif -%}

    {%- when 'image' -%}
      <div class="pan__media">
        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag:
            widths: '600, 900, 1200, 1600, 2000, 2400',
            sizes: '100vw',
            loading: 'lazy',
            alt: section.settings.image_alt
        }}
      </div>

    {%- else -%}
      {%- if request.design_mode -%}
        <div class="pan__media pan__media--placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag: 'pan__placeholder-svg' }}
        </div>
      {%- endif -%}
  {%- endcase -%}
</section>

{% stylesheet %}
  .pan { background: #FFFFFF; color: #1D1D1F; }
  /* Tighten the gap from the buy area (share row) to this nav — the theme's
     default section spacing was reading as too much air on mobile
     (Eddie 2026-07-23 review). Match the intra-section rhythm (~16px). */
  .shopify-section--pdp-anchor-nav {
    margin-top: 0;
  }
  @media screen and (max-width: 749px) {
    .shopify-section--pdp-anchor-nav {
      margin-top: -20px;
    }
  }
  /* Outer wrapper centers the strip; hairlines live on the inner list so
     they only span the content column (Pitaka-style), not edge-to-edge. */
  .pan__nav {
    display: flex;
    justify-content: center;
    padding: 0 var(--outer, 20px);
    background: #FFFFFF;
  }
  .pan__nav--sticky {
    position: sticky;
    top: var(--header-height, 0px);
    z-index: 5;
  }
  .pan__list {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: var(--page-width, 1200px);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .pan__item {
    padding: 0;
  }
  .pan__link {
    display: inline-block;
    padding: 12px 4px;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #000;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .pan__link:hover { text-decoration: underline; }
  .pan__link:focus-visible {
    outline: 2px solid var(--focus, #1D1D1F);
    outline-offset: -2px;
  }
  .pan__media { margin: 0; }
  .pan__media img,
  .pan__media svg,
  .pan__media video {
    display: block;
    width: 100%;
    height: auto;
  }
  .pan__media--product-video {
    display: flex;
    justify-content: center;
    overflow: hidden;
    background: #000;
  }
  .pan__media--product-video video {
    width: auto;
    max-width: 100%;
    height: min(90vh, 1080px);
    max-height: 90vh;
    object-fit: contain;
  }
  /* Embedded video URL (YouTube/Vimeo) needs a fixed aspect ratio wrapper
     because iframes have no intrinsic size. 16:9 matches both platforms'
     default player. */
  .pan__media--embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }
  .pan__media--embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .pan__media--placeholder svg { background: #F4F4F4; aspect-ratio: 16 / 9; }

  @media screen and (max-width: 749px) {
    .pan__link { padding: 10px 2px; font-size: 12px; letter-spacing: 0.06em; }
    .pan__media--product-video video {
      width: 100%;
      height: auto;
      max-height: none;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    var scope = document.querySelectorAll('[data-pdp-anchor-nav]');
    scope.forEach(function (section) {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      section.querySelectorAll('[data-pdp-anchor-link]').forEach(function (link) {
        link.addEventListener('click', function (e) {
          var id = link.getAttribute('href').slice(1);
          var target = document.getElementById(id);
          if (!target) return;
          e.preventDefault();
          target.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
          if (history.replaceState) history.replaceState(null, '', '#' + id);
        });
      });

      // Lazy-load Shopify-hosted <video> when it enters the viewport, so we
      // don't fire a video download on pages the shopper never scrolls to.
      var video = section.querySelector('[data-pan-video]');
      if (!video || !('IntersectionObserver' in window)) return;
      var io = new IntersectionObserver(function (entries, obs) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) return;
          if (video.paused && video.hasAttribute('autoplay')) {
            var p = video.play();
            if (p && typeof p.catch === 'function') p.catch(function () {});
          }
          obs.unobserve(video);
        });
      }, { rootMargin: '200px 0px' });
      io.observe(video);
    });
  })();
</script>

{% schema %}
{
  "name": "PDP anchor nav",
  "tag": "section",
  "class": "shopify-section--pdp-anchor-nav",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "text",
      "id": "nav_aria_label",
      "label": "Nav accessible label",
      "default": "Product sections"
    },
    {
      "type": "checkbox",
      "id": "sticky_enabled",
      "label": "Stick nav under header on scroll",
      "default": false
    },
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "info": "Auto uses whichever slot below is filled — video wins over image if both are set.",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video (uploaded)" },
        { "value": "video_url", "label": "Video URL (YouTube / Vimeo)" }
      ],
      "default": "auto"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image / video alt text",
      "info": "Describe the media for screen readers and SEO."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video (uploaded)",
      "info": "Upload an .mp4 to your Shopify Files. Autoplay works only when muted."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video URL",
      "accept": ["youtube", "vimeo"],
      "info": "Paste a YouTube or Vimeo URL. Autoplay-muted-loop is applied when 'Autoplay' below is on."
    },
    {
      "type": "checkbox",
      "id": "video_autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "video_loop",
      "label": "Loop",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "video_muted",
      "label": "Muted",
      "info": "Required for autoplay in most browsers.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "video_controls",
      "label": "Show video controls",
      "info": "Uploaded videos only. External embeds follow the platform's defaults.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Nav link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Details"
        },
        {
          "type": "text",
          "id": "anchor",
          "label": "Target anchor id",
          "info": "The id of the area to scroll to (with or without #). Product detail story uses: product-details, product-why, product-size-guide.",
          "default": "product-details"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "PDP anchor nav",
      "blocks": [
        { "type": "link", "settings": { "label": "Details", "anchor": "product-details" } },
        { "type": "link", "settings": { "label": "Why This Works", "anchor": "product-why" } },
        { "type": "link", "settings": { "label": "Find Your Size", "anchor": "product-size-guide" } }
      ]
    }
  ]
}
{% endschema %}
