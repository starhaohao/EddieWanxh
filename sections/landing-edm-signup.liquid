{%- comment -%}
  EDM / email signup (FABRIC V2 blueprint §4.2).
  Posts to Shopify's native customer form (creates a marketing subscriber) —
  usable below the hero or dropped between content. Two layouts: centred
  (editorial) or inline (slim mid-content band). Refined CDLP styling:
  eyebrow, clean grotesque headline, underline field, tracked uppercase submit.
{%- endcomment -%}

{%- liquid
  assign uid = section.id
  assign field_id = 'edm-email-' | append: uid
  assign form_id = 'edm-form-' | append: uid
  assign layout = section.settings.layout | default: 'centered'
  assign bg = section.settings.background | default: 'paper'
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: {{ section.settings.padding_left }}px;
    padding-right: {{ section.settings.padding_right }}px;
  }
{% endstyle %}

<section class="edm edm--{{ layout }} edm--bg-{{ bg }}" id="edm-{{ uid }}">
  <div class="edm__inner">
    <div class="edm__copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="edm__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="edm__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p class="edm__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    <div class="edm__form-wrap">
      {%- form 'customer', id: form_id, class: 'edm__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, prospect">
        <label class="edm__label" for="{{ field_id }}">{{ section.settings.placeholder }}</label>
        <div class="edm__field">
          <input
            type="email"
            name="contact[email]"
            id="{{ field_id }}"
            class="edm__input"
            value="{% if form.email %}{{ form.email }}{% endif %}"
            placeholder="{{ section.settings.placeholder }}"
            autocomplete="email"
            autocapitalize="off"
            autocorrect="off"
            required
          >
          <button type="submit" class="edm__submit">
            <span>{{ section.settings.button_label }}</span>
            <span aria-hidden="true" class="edm__arrow">&#8594;</span>
          </button>
        </div>

        {%- if form.posted_successfully? -%}
          <p class="edm__msg edm__msg--ok">{{ section.settings.success_text }}</p>
        {%- elsif form.errors -%}
          <p class="edm__msg edm__msg--err">{{ form.errors.translated_fields.email | default: 'Email' | capitalize }} {{ form.errors.messages.email | default: 'is invalid.' }}</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{%- style -%}
  .edm {
    --edm-ink: #17191C;
    --edm-paper: #F2EEE7;
    --edm-white: #FFFFFF;
    --edm-soft: rgba(23, 25, 28, 0.55);
    --edm-hair: rgba(23, 25, 28, 0.22);
    background: var(--edm-paper);
    color: var(--edm-ink);
  }
  .edm--bg-white { background: var(--edm-white); }
  .edm--bg-ink {
    background: var(--edm-ink);
    color: #EDE9E0;
    --edm-soft: rgba(237, 233, 224, 0.55);
    --edm-hair: rgba(237, 233, 224, 0.30);
  }

  .edm__inner { max-width: 560px; margin: 0 auto; text-align: center; }
  .edm__eyebrow {
    display: block;
    font-family: 'Archivo', 'Helvetica Neue', Arial, sans-serif;
    font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase;
    color: var(--edm-soft); margin-bottom: 18px;
  }

  /* Heading aligned to theme heading font (Typography settings) */
  .edm__heading {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: clamp(26px, 3.6vw, 40px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0 0 14px;
    text-wrap: balance;
  }
  .edm__subtext { font-size: 15px; line-height: 1.65; color: var(--edm-soft); margin: 0 auto 34px; max-width: 44ch; }

  .edm__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .edm__field {
    display: flex; align-items: center; gap: 16px;
    max-width: 420px; margin: 0 auto;
    border-bottom: 1px solid var(--edm-hair);
    padding-bottom: 12px; transition: border-color 0.25s ease;
  }
  .edm__field:focus-within { border-color: currentColor; }
  .edm__input {
    flex: 1 1 auto; min-width: 0; border: 0; background: transparent; padding: 0;
    font-family: inherit; font-size: 16px; color: inherit; letter-spacing: 0.01em; height: 28px;
  }
  .edm__input:focus { outline: none; }
  .edm__input::placeholder { color: var(--edm-soft); }
  .edm__submit {
    flex: 0 0 auto; border: 0; background: transparent; color: inherit; cursor: pointer;
    font-family: 'Archivo', 'Helvetica Neue', Arial, sans-serif;
    font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase;
    display: inline-flex; align-items: center; gap: 8px; padding: 0;
    transition: opacity 0.2s ease;
  }
  .edm__submit:hover { opacity: 0.55; }
  .edm__arrow { transition: transform 0.25s ease; }
  .edm__submit:hover .edm__arrow { transform: translateX(4px); }
  .edm__msg { margin: 16px 0 0; font-size: 13px; letter-spacing: 0.02em; color: var(--edm-soft); }
  .edm__msg--err { color: #923531; }

  /* Inline — slim band to sit between content sections */
  .edm--inline .edm__inner {
    max-width: 1080px; display: flex; align-items: center;
    justify-content: space-between; gap: clamp(24px, 5vw, 72px); text-align: left;
  }
  .edm--inline .edm__copy { flex: 1 1 auto; }
  .edm--inline .edm__eyebrow { margin-bottom: 12px; }
  .edm--inline .edm__heading { font-size: clamp(24px, 3vw, 34px); margin-bottom: 6px; }
  .edm--inline .edm__subtext { margin: 0; max-width: 46ch; }
  .edm--inline .edm__form-wrap { flex: 0 0 auto; width: min(400px, 100%); }
  .edm--inline .edm__field { margin: 0; }

  @media screen and (max-width: 749px) {
    .edm--inline .edm__inner { flex-direction: column; align-items: stretch; text-align: center; }
    .edm--inline .edm__form-wrap { width: 100%; }
    .edm--inline .edm__field { margin: 0 auto; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "EDM Signup",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "centered", "label": "Centred (editorial)" },
        { "value": "inline", "label": "Inline band (between content)" }
      ],
      "default": "centered"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background preset",
      "options": [
        { "value": "paper", "label": "Paper" },
        { "value": "white", "label": "White" },
        { "value": "ink", "label": "Ink (dark)" }
      ],
      "default": "paper"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color (custom)",
      "default": "#F2EEE7",
      "info": "Overrides the background preset above"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0, "max": 160, "step": 4, "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0, "max": 160, "step": 4, "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding left",
      "min": 0, "max": 120, "step": 4, "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding right",
      "min": 0, "max": 120, "step": 4, "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Content"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "First Layer" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the list" },
    { "type": "text", "id": "subtext", "label": "Sentence", "default": "First access to drops, restocks and Story Salon." },
    { "type": "text", "id": "placeholder", "label": "Field placeholder", "default": "Email address" },
    { "type": "text", "id": "button_label", "label": "Submit label", "default": "Sign up" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "You're in — welcome to First Layer." }
  ],
  "presets": [{ "name": "EDM Signup" }]
}
{% endschema %}
