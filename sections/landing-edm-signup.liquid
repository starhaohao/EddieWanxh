{%- comment -%}
  EDM / email signup (FABRIC V2 blueprint §4.2).
  Posts to Shopify's native customer form (creates a marketing subscriber).
  Layout updated to display side-by-side on desktop and stacked on mobile.
{%- endcomment -%}

{%- liquid
  assign uid = section.id
  assign field_id = 'edm-email-' | append: uid
  assign form_id = 'edm-form-' | append: uid
  assign layout = section.settings.layout | default: 'centered'
  assign font_alpha = section.settings.font_opacity | divided_by: 100.0
  assign input_alpha = section.settings.input_opacity | divided_by: 100.0
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  #shopify-section-{{ section.id }} .edm {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    padding-left: {{ section.settings.padding_left }}px;
    padding-right: {{ section.settings.padding_right }}px;
    --edm-ink: {{ section.settings.font_color | color_modify: 'alpha', font_alpha }};
    --edm-soft: {{ section.settings.font_color | color_modify: 'alpha', font_alpha | times: 0.55 }};
    --edm-hair: {{ section.settings.font_color | color_modify: 'alpha', font_alpha | times: 0.22 }};
    --edm-input: {{ section.settings.input_color | color_modify: 'alpha', input_alpha }};
    color: var(--edm-ink);
  }

  /* Dynamic Alignment Settings */
  #shopify-section-{{ section.id }} .edm__inner {
    text-align: {{ section.settings.text_alignment }};
    {% if section.settings.text_alignment == 'left' %}
      align-items: flex-start;
    {% elsif section.settings.text_alignment == 'center' %}
      align-items: center;
    {% elsif section.settings.text_alignment == 'right' %}
      align-items: flex-end;
    {% endif %}
  }

  /* Desktop Alignment Adjustments */
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .edm__inner {
      {% if section.settings.text_alignment == 'left' %}
        justify-content: flex-start;
      {% elsif section.settings.text_alignment == 'center' %}
        justify-content: center;
      {% elsif section.settings.text_alignment == 'right' %}
        justify-content: flex-end;
      {% endif %}
      align-items: center; /* Always keep vertically centered on desktop */
    }
  }

  #shopify-section-{{ section.id }} .edm__input,
  #shopify-section-{{ section.id }} .edm__input::placeholder {
    color: var(--edm-input);
  }

  #shopify-section-{{ section.id }} .edm__heading,
  #shopify-section-{{ section.id }} .edm__subtext,
  #shopify-section-{{ section.id }} .edm__eyebrow,
  #shopify-section-{{ section.id }} .edm__submit,
  #shopify-section-{{ section.id }} .edm__secondary,
  #shopify-section-{{ section.id }} .edm__msg--ok {
    color: var(--edm-ink);
  }

  #shopify-section-{{ section.id }} .edm__subtext {
    color: var(--edm-soft);
  }
{% endstyle %}

<section class="edm edm--{{ layout }}" id="edm-{{ uid }}">
  <div class="edm__inner">
    
    <div class="edm__copy">
      {%- if section.settings.eyebrow != blank -%}
        <span class="edm__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="edm__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.subtext != blank -%}
        <p class="edm__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}
    </div>

    <div class="edm__form-wrap">
      {%- form 'customer', id: form_id, class: 'edm__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter, prospect">

        <label class="edm__label" for="{{ field_id }}">
          {{ section.settings.placeholder }}
        </label>

        <div class="edm__field">
          <input
            type="email"
            name="contact[email]"
            id="{{ field_id }}"
            class="edm__input"
            value="{% if form.email %}{{ form.email }}{% endif %}"
            placeholder="{{ section.settings.placeholder }}"
            autocomplete="email"
            autocapitalize="off"
            autocorrect="off"
            required
          >

          <button type="submit" class="edm__submit">
            <span>{{ section.settings.button_label }}</span>
            <span aria-hidden="true" class="edm__arrow">&#8594;</span>
          </button>
        </div>

        {%- if form.posted_successfully? -%}
          <p class="edm__msg edm__msg--ok">{{ section.settings.success_text }}</p>
        {%- elsif form.errors -%}
          <p class="edm__msg edm__msg--err">
            {{ form.errors.translated_fields.email | default: 'Email' | capitalize }}
            {{ form.errors.messages.email | default: 'is invalid.' }}
          </p>
        {%- endif -%}
      {%- endform -%}
    </div>
    
  </div>
</section>

{%- style -%}
  /* Base Layout (Mobile First - Stacked) */
  .edm__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Desktop Layout (Row - Side by side) */
  @media screen and (min-width: 750px) {
    .edm__inner {
      flex-direction: row;
      gap: 40px; /* Space between text block and form block */
    }
  }

  .edm__copy {
    display: flex;
    flex-direction: column;
    gap: 8px; /* Space between eyebrow, heading, and sentence */
    flex: 0 1 auto;
  }

  .edm__eyebrow {
    display: block;
    font-family: 'Archivo', 'Helvetica Neue', Arial, sans-serif;
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    margin: 0;
  }

  .edm__heading {
    font-family: var(--font-heading-family);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    font-size: clamp(26px, 3.6vw, 40px);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0;
    text-wrap: balance;
  }

  .edm__subtext {
    font-size: 15px;
    line-height: 1.65;
    margin: 0;
    max-width: 44ch;
  }

  .edm__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .edm__form-wrap {
    flex: 0 1 auto;
    width: 100%;
    max-width: 420px;
  }

  .edm__field {
    display: flex;
    align-items: center;
    gap: 16px;
    background-color: transparent; 
    padding: 0; 
    border: 0; 
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }

  .edm__input {
    flex: 1 1 auto;
    min-width: 0;
    border: 1px solid transparent; 
    background: transparent;
    font-family: inherit;
    font-size: 8px; /* Half size */
    letter-spacing: 0.01em;
    height: 14px; 
    padding: 10px 18px; 
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.15); /* Transparent box around input only */
  }

  .edm__input:focus {
    outline: none;
    background-color: rgba(255, 255, 255, 0.2);
    border-color: var(--edm-hair);
  }

  .edm__input::placeholder {
    color: var(--edm-input);
  }

  .edm__submit {
    flex: 0 0 auto;
    border: 0;
    background: transparent;
    cursor: pointer;
    font-family: 'Archivo', 'Helvetica Neue', Arial, sans-serif;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0;
    transition: opacity 0.2s ease;
  }

  .edm__submit > span:first-child {
    text-decoration: underline; /* Underline ONLY on sign up text */
    text-underline-offset: 4px; 
  }
  
  .edm__submit .edm__arrow {
    text-decoration: none;
    transition: transform 0.25s ease;
  }

  .edm__submit:hover {
    opacity: 0.55;
  }

  .edm__submit:hover .edm__arrow {
    transform: translateX(4px);
  }

  .edm__msg {
    margin: 16px 0 0;
    font-size: 13px;
    letter-spacing: 0.02em;
  }

  .edm__msg--err {
    color: #923531;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "EDM Signup",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "centered", "label": "Centred (editorial)" },
        { "value": "inline", "label": "Inline band (between content)" }
      ],
      "default": "centered"
    },
    {
      "type": "header",
      "content": "Alignment"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F2EEE7"
    },
    {
      "type": "color",
      "id": "font_color",
      "label": "Font color (heading, subtext, eyebrow, button)",
      "default": "#17191C"
    },
    {
      "type": "range",
      "id": "font_opacity",
      "label": "Font opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "color",
      "id": "input_color",
      "label": "Email input text color",
      "default": "#17191C"
    },
    {
      "type": "range",
      "id": "input_opacity",
      "label": "Email input opacity",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Section Margin"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Inner Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding left",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding right",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "First Layer"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the list"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Sentence",
      "default": "First access to drops, restocks and Story Salon."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Field placeholder",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Submit label",
      "default": "Sign up"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "You're in — welcome to First Layer."
    }
  ],
  "presets": [
    {
      "name": "EDM Signup"
    }
  ]
}
{% endschema %}