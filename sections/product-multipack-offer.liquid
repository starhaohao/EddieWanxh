<style>
/* ============================================================
   MPO — Multi-Pack Offer
   ============================================================ */

/* Design tokens */
.mpo {
  --mpo-bg:         #ffffffff;
  --mpo-raised:     #2c3035;
  --mpo-border:     rgba(0, 0, 0, 0.12);
  --mpo-text:       #000000ff;
  --mpo-muted:      rgba(255, 255, 255, 0.45);
  --mpo-crimson:    #fbff0fff;
  --mpo-crimson-h:  #e8e8e8ff;
  --mpo-mono:       'Helvetica Neue', Helvetica, Arial, sans-serif;
}

/* ── Label ─────────────────────────────────────────────────── */
.mpo__label {
  font-family:     var(--mpo-mono);
  font-size:       10px;
  text-transform:  uppercase;
  letter-spacing:  0.1em;
  color:           var(--mpo-muted);
  margin-bottom:   12px;
}

/* ── Tier list ──────────────────────────────────────────────── */
.mpo__tiers {
  border: 1px solid var(--mpo-border);
  border-radius: 4px;
  overflow: hidden;
}

/* ── Individual tier row ────────────────────────────────────── */
.mpo__tier {
  display:          flex;
  align-items:      center;
  gap:              14px;
  padding:          15px 16px;
  border-bottom:    1px solid var(--mpo-border);
  cursor:           pointer;
  position:         relative;
  background:       var(--mpo-bg);
  border-left:      2px solid transparent;
  user-select:      none;
  transition:       background 0.18s, border-left-color 0.18s;
}

.mpo__tier:last-child       { border-bottom: none; }
.mpo__tier:hover:not(.is-on) { background: rgba(0, 0, 0, 0.02); }

.mpo__tier.is-on {
  background:       var(--mpo-raised);
  border-left-color: var(--mpo-crimson);
}

/* ── Hidden native radio ────────────────────────────────────── */
.mpo__radio-input {
  position:        absolute;
  opacity:         0;
  width:           0;
  height:          0;
  pointer-events:  none;
}

/* ── Custom radio ───────────────────────────────────────────── */
.mpo__radio {
  width:            15px;
  height:           15px;
  border:           1px solid rgba(255, 255, 255, 0.25);
  border-radius:    50%;
  background:       rgba(255, 255, 255, 0.25);
  flex-shrink:      0;
  display:          flex;
  align-items:      center;
  justify-content:  center;
  transition:       border-color 0.18s;
}

.mpo__tier.is-on .mpo__radio { border-color: var(--mpo-crimson); }

.mpo__radio-dot {
  width:            7px;
  height:           7px;
  border-radius:    50%;
  background:       var(--mpo-crimson);
  transform:        scale(0);
  transition:       transform 0.18s;
}

.mpo__tier.is-on .mpo__radio-dot { transform: scale(1); }

/* ── Text block ─────────────────────────────────────────────── */
.mpo__info {
  flex:             1;
  display:          flex;
  flex-direction:   column;
  gap:              2px;
}

.mpo__name {
  font-size:        17px;
  letter-spacing:   -0.03em;
  color:            var(--mpo-text);
}

.mpo__sub {
  font-family:      var(--mpo-mono);
  font-size:        9px;
  text-transform:   uppercase;
  letter-spacing:   0.1em;
  color:            var(--mpo-muted);
}

/* ── Pricing block ──────────────────────────────────────────── */
.mpo__pricing {
  text-align:       right;
  display:          flex;
  flex-direction:   column;
  gap:              2px;
  color:            var(--mpo-text);
}

.mpo__total { font-size: 15px; }

.mpo__unit {
  font-family:      var(--mpo-mono);
  font-size:        9px;
  text-transform:   uppercase;
  letter-spacing:   0.08em;
  color:            var(--mpo-muted);
}

.mpo__compare {
  font-size:        10px;
  color:            rgba(255, 255, 255, 0.28);
  text-decoration:  line-through;
}

/* ── Save tag ───────────────────────────────────────────────── */
.mpo__save-tag {
  position:         absolute;
  top:              0;
  right:            0;
  background:       var(--mpo-crimson);
  color:            #fff;
  font-family:      var(--mpo-mono);
  font-size:        8px;
  text-transform:   uppercase;
  letter-spacing:   0.1em;
  padding:          3px 7px;
  border-bottom-left-radius: 3px;
}

/* ── ATC button ─────────────────────────────────────────────── */
.mpo__atc {
  width:            100%;
  padding:          17px;
  margin-top:       2px;
  background:       var(--mpo-crimson);
  color:            #fff;
  border:           none;
  font-size:        11px;
  text-transform:   uppercase;
  letter-spacing:   0.12em;
  cursor:           pointer;
  display:          flex;
  align-items:      center;
  justify-content:  center;
  gap:              14px;
  transition:       background 0.2s;
}

.mpo__atc:hover             { background: var(--mpo-crimson-h); }
.mpo__atc:disabled          { opacity: 0.6; cursor: not-allowed; }

.mpo__atc-sub {
  font-size:        10px;
  opacity:          0.6;
  letter-spacing:   0.06em;
}
</style>
