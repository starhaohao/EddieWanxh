{%- liquid
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
-%}

<section class="sel-options" style="--sel-opt-bg: {{ bg_color }}; --sel-opt-text: {{ text_color }};">
  <div class="sel-options__container">
    {%- if section.settings.title != blank -%}
      <h2 class="sel-options__title">{{ section.settings.title }}</h2>
    {%- endif -%}

    <div class="sel-options__grid">
      {%- for block in section.blocks -%}
        <div class="sel-options__item" {{ block.shopify_attributes }}>
          <div class="sel-options__item-header">
            <h3 class="sel-options__item-title">{{ block.settings.label }}</h3>
            {%- if block.settings.badge != blank -%}
              <span class="sel-options__badge">{{ block.settings.badge }}</span>
            {%- endif -%}
          </div>

          {%- if block.settings.options != blank -%}
            <div class="sel-options__item-options">
              {%- assign option_lines = block.settings.options | split: ',' -%}
              {%- for option in option_lines -%}
                {%- if option != blank -%}
                  <div class="sel-options__option">
                    <span class="sel-options__option-text">{{ option | strip }}</span>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if block.settings.description != blank -%}
            <p class="sel-options__item-desc">{{ block.settings.description }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .sel-options {
    padding: 64px 40px;
    background: var(--sel-opt-bg);
    color: var(--sel-opt-text);
  }

  .sel-options__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .sel-options__title {
    font-size: 36px;
    letter-spacing: -0.02em;
    margin: 0 0 48px;
    font-weight: 600;
    line-height: 1.2;
  }

  .sel-options__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 28px;
  }

  .sel-options__item {
    padding: 24px;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.5);
    transition: all 0.3s ease;
  }

  .sel-options__item:hover {
    border-color: rgba(0, 0, 0, 0.15);
    background: rgba(255, 255, 255, 0.8);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  .sel-options__item-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
    gap: 12px;
  }

  .sel-options__item-title {
    font-size: 16px;
    font-weight: 600;
    margin: 0;
    letter-spacing: -0.01em;
  }

  .sel-options__badge {
    display: inline-block;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 4px 8px;
    background: rgba(0, 0, 0, 0.08);
    border-radius: 2px;
    font-weight: 500;
    white-space: nowrap;
  }

  .sel-options__item-options {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 12px;
  }

  .sel-options__option {
    display: inline-flex;
    align-items: center;
    padding: 6px 12px;
    background: rgba(0, 0, 0, 0.04);
    border-radius: 2px;
    font-size: 12px;
    letter-spacing: 0.02em;
  }

  .sel-options__option-text {
    margin: 0;
  }

  .sel-options__item-desc {
    font-size: 13px;
    opacity: 0.7;
    margin: 0;
    line-height: 1.5;
  }

  @media (max-width: 989px) {
    .sel-options {
      padding: 48px 24px;
    }

    .sel-options__title {
      font-size: 28px;
      margin-bottom: 36px;
    }

    .sel-options__grid {
      gap: 20px;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
  }

  @media (max-width: 749px) {
    .sel-options {
      padding: 40px 16px;
    }

    .sel-options__title {
      font-size: 20px;
      margin-bottom: 24px;
    }

    .sel-options__grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .sel-options__item {
      padding: 16px;
    }

    .sel-options__item-title {
      font-size: 14px;
    }

    .sel-options__item-options {
      gap: 6px;
    }

    .sel-options__option {
      padding: 4px 8px;
      font-size: 11px;
    }
  }
</style>

{% schema %}
{
  "name": "Selection Options",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Our Selection Options"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#17191c"
    }
  ],
  "blocks": [
    {
      "type": "option_group",
      "name": "Option Group",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Group label",
          "default": "Design"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge (optional)",
          "placeholder": "e.g., New, Popular"
        },
        {
          "type": "textarea",
          "id": "options",
          "label": "Options (comma-separated)",
          "placeholder": "Classic, Modern, Minimal",
          "default": "Classic, Modern, Minimal"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "placeholder": "Choose from our curated designs"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Selection Options",
      "blocks": [
        {
          "type": "option_group",
          "settings": {
            "label": "Design",
            "options": "Classic, Modern, Minimal",
            "description": "Choose your preferred style"
          }
        },
        {
          "type": "option_group",
          "settings": {
            "label": "Fabric",
            "options": "Moisture-wicking, Soft-touch, Premium",
            "description": "Select your material preference"
          }
        },
        {
          "type": "option_group",
          "settings": {
            "label": "Size Range",
            "badge": "XS-2XL",
            "options": "XS, S, M, L, XL, 2XL",
            "description": "All bodies welcome"
          }
        }
      ]
    }
  ],
  "templates": ["page", "index"]
}
{% endschema %}
