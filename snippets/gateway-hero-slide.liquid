{%- comment -%}
  Renders one Gateway Hero slide. Used for both manual slide blocks and
  metaobject-sourced slides so the two share identical markup.

  Accepts:
  - image     {Object}  image/media object (or blank -> placeholder)
  - focal     {String}  object-position, e.g. "50% 30%" (default 'center')
  - link      {String}  slide href (default '#')
  - micro     {String}  monospace micro label
  - title     {String}  headline
  - price     {String}  price line
  - cta       {String}  CTA text (blank hides the button)
  - is_first  {Boolean} eager-load + focusable first slide
  - position  {Int}     1-based index (for aria-label)
  - total     {Int}     total slide count (for aria-label)
  - attrs     {String}  optional block.shopify_attributes
  - micro_as_badge {Boolean} render the micro label as a bordered badge chip
{%- endcomment -%}
{%- liquid
  assign focal = focal | default: 'center'
  assign link = link | default: '#'
  assign micro_class = 'gh__micro'
  if micro_as_badge
    assign micro_class = 'gh__micro gh__micro--badge'
  endif
-%}
<li
  class="gh__slide"
  data-gh-slide
  {{ attrs }}
  role="group"
  aria-roledescription="slide"
  aria-label="{{ position }} of {{ total }}"
  {% unless is_first %}aria-hidden="true"{% endunless %}
>
  <a class="gh__slide-link" href="{{ link }}" {% unless is_first %}tabindex="-1"{% endunless %}>
    {%- if image != blank -%}
      <img
        class="gh__img"
        src="{{ image | image_url: width: 900 }}"
        srcset="{{ image | image_url: width: 480 }} 480w, {{ image | image_url: width: 720 }} 720w, {{ image | image_url: width: 900 }} 900w, {{ image | image_url: width: 1280 }} 1280w, {{ image | image_url: width: 1600 }} 1600w"
        sizes="calc(100vw - 88px)"
        width="{{ image.width }}"
        height="{{ image.height }}"
        alt="{{ image.alt | default: title | escape }}"
        loading="{% if is_first %}eager{% else %}lazy{% endif %}"
        {% if is_first %}fetchpriority="high"{% else %}fetchpriority="low"{% endif %}
        decoding="async"
        style="object-position: {{ focal }};"
      >
    {%- else -%}
      <div class="gh__img gh__img--placeholder">{{ 'lifestyle-1' | placeholder_svg_tag: 'gh__placeholder-svg' }}</div>
    {%- endif -%}

    <div class="gh__caption">
      {%- if micro != blank -%}
        <p class="{{ micro_class }}">{{ micro }}</p>
      {%- endif -%}
      {%- if title != blank -%}
        <p class="gh__title h3">{{ title }}</p>
      {%- endif -%}
      {%- if price != blank -%}
        <p class="gh__price">{{ price }}</p>
      {%- endif -%}
      {%- if cta != blank -%}
        <span class="gh__cta btn btn--solid btn--primary">
          {{ cta }}
          <svg viewBox="0 0 14 14" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 7h10M8 3l4 4-4 4"/></svg>
        </span>
      {%- endif -%}
    </div>
  </a>
</li>
