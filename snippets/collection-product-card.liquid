{%- comment -%}
  Collection Product Card — redesigned per the approved Figma design
  system (file "TRIIIPLE Studio — Wireframes", boards "COLLECTION PAGE
  HERO — Desktop/Mobile"). Used only by sections/collection.liquid's
  product grid.

  Deliberately a separate snippet rather than an edit to
  snippets/product-grid-item.liquid: that snippet is shared by the
  homepage collection carousels and the PDP related-products grid
  (already redesigned/shipped in earlier work this session), and this
  request is scoped to the collection page template — restyling the
  shared snippet would have cascaded this look onto pages nobody asked
  to change.

  Reused as-is (mechanics untouched, only wrapped in new markup/CSS):
  - snippets/product-grid-price.liquid — price/compare-at price logic
  - snippets/product-badge.liquid — badge markup
  - snippets/quick-add-product.liquid — add-to-cart / quick-add wiring
  - assets/grid-item.js — recently-viewed cookie check (via the
    <grid-item> custom element + data-recently-viewed-indicator
    contract already used by product-grid-item.liquid)

  Accepts:
  - product: {Object} product (required)
  - index: {Int} 1-based loop index, for eager/lazy image loading
  - sizes: {String} image sizes attribute
{%- endcomment -%}

{%- liquid
  assign current_variant = product.first_available_variant
  assign product_url = product.url | within: collection
  assign product_display_name = product.title | strip_html
  assign pc_meta = product.metafields.custom.product_content.value
  assign direct_display_name = product.metafields.custom.display_name.value | strip_html | strip

  if direct_display_name != blank
    assign product_display_name = direct_display_name
  elsif pc_meta != blank and pc_meta.display_name.value != blank
    assign product_display_name = pc_meta.display_name.value | strip_html | strip
  endif

  # Bundles don't follow the "<design code> <type>" naming convention
  # (e.g. "First Layer Duo", "The Brief Lover") — splitting on the first
  # word would bold an arbitrary article/word instead of a real design
  # code, so bundles render their whole name as one bold string instead.
  assign product_card_source = product.type | append: ' ' | append: product.handle | append: ' ' | append: product.title | append: ' ' | append: product.tags | downcase
  assign is_bundle_product = false
  if product_card_source contains 'bundle'
    assign is_bundle_product = true
  endif

  # Product Information Standard v2.0 naming is always "<design code>
  # <type>" as one string (e.g. "V Brief", "ED Sleeveless Top") — split
  # on the first space so the code renders Bold and the type renders
  # Medium, generically for any code, no hardcoded V/W/H/Y/X/ED/L list.
  if is_bundle_product
    assign name_code = product_display_name
    assign name_type = blank
  else
    assign name_code = product_display_name | split: ' ' | first
    assign name_type = product_display_name | remove_first: name_code | strip
  endif

  assign material_label = product.metafields.theme.cutline.value | strip_html | strip
  assign normalized_material = material_label | downcase | remove: '®' | strip
  if normalized_material contains 'transdry'
    assign material_label = 'TransDRY®'
  else
    assign material_label = material_label | upcase
  endif

  assign index = index | default: 1
  assign loading = 'lazy'
  if index <= 3
    assign loading = 'eager'
  endif

  assign aspect_ratio = 1 | divided_by: settings.product_grid_aspect_ratio
  assign widths = '280, 400, 480, 600, 760, 900, 1080'
  if sizes == blank
    assign sizes = '(min-width: 990px) 33vw, 50vw'
  endif

  capture item_unique
    echo 'pcard-' | append: section.id | append: '-' | append: product.id
  endcapture

  assign aos_anchor = '#' | append: item_unique
  capture image_animations
    echo 'data-aos="img-in" data-aos-duration="800" data-aos-anchor="' | append: aos_anchor | append: '" data-aos-easing="ease-out-quart"'
  endcapture

  # Sale % badge — best-variant-discount computation, looping
  # product.variants directly rather than gating on the top-level
  # product.compare_at_price/product.price fields (which Shopify Liquid
  # derives from whichever variant happens to be "first," and can be
  # blank even when other variants -- e.g. on multi-variant bundles --
  # clearly are discounted, silently hiding the badge). This is card
  # display logic, not the native Shopify filter system, so it's not
  # the "duplicated filter logic" this redesign was told to avoid.
  assign sale_price_compare = 0
  assign sale_price_difference = 0

  for variant in product.variants
    if variant.available and variant.compare_at_price > variant.price
      assign variant_price_difference = variant.compare_at_price | minus: variant.price
      if variant_price_difference > sale_price_difference
        assign sale_price_compare = variant.compare_at_price
        assign sale_price_difference = variant_price_difference
      endif
    endif
  endfor

  if sale_price_compare > 0 and sale_price_difference > 0 and settings.sale_tags_enable
    assign percent_off = sale_price_difference | times: 100.0 | divided_by: sale_price_compare
    assign sale_badge_text = percent_off | floor | append: '%'
  endif

  assign is_recently_viewed_enabled = settings.show_recently_viewed_indicator
  assign hidden_product = false
  if product.tags contains 'hide'
    assign hidden_product = true
  endif
-%}

{%- unless hidden_product -%}
  <grid-item class="pcard" id="{{ item_unique }}" data-grid-item data-url="{{ product.url }}">
    <a href="{{ product_url }}" class="pcard__image" style="aspect-ratio: {{ aspect_ratio }};" aria-label="{{ product_display_name | escape }}">
      {%- if product.featured_media != blank -%}
        {%- render 'image',
          image: product.featured_media.preview_image,
          aspect_ratio: aspect_ratio,
          sizes: sizes,
          widths: widths,
          loading: loading,
          attributes: image_animations,
          cover: true
        -%}
      {%- else -%}
        <div class="pcard__image-empty"></div>
      {%- endif -%}

      {%- if sale_badge_text != blank and product.available -%}
        {%- render 'product-badge',
          badge_class: 'pcard__badge pcard__badge--sale',
          badge_text: sale_badge_text,
          aos_delay: 0,
          aos_duration: 0,
          aos_anchor: ''
        -%}
      {%- endif -%}

      {%- if is_recently_viewed_enabled -%}
        <span
          class="pcard__badge pcard__badge--viewed hidden"
          data-recently-viewed-indicator
          data-product-handle="{{ product.handle }}"
        >
          {{- 'products.general.recently_viewed' | t | default: 'Recently Viewed' -}}
        </span>
      {%- endif -%}
    </a>

    <div class="pcard__info">
      <a href="{{ product_url }}" class="pcard__name-link">
        <p class="pcard__name">
          <span class="pcard__name-code">{{ name_code }}</span>{% if name_type != blank %} <span class="pcard__name-type">{{ name_type }}</span>{% endif %}
        </p>
        {%- if material_label != blank -%}
          <p class="pcard__material">{{ material_label }}</p>
        {%- endif -%}
      </a>

      <div class="pcard__foot">
        <div class="pcard__price">
          {%- render 'product-grid-price', product: product, current_variant: current_variant -%}
        </div>

        {%- if product.available -%}
          {%- render 'quick-add-product',
            product: product,
            holder_modifier: '',
            btn_style: '',
            use_icon: true,
            icon: 'plus',
            icon_button_class: 'pcard__quickadd'
          -%}
        {%- endif -%}
      </div>
    </div>
  </grid-item>
{%- endunless -%}

<style>
  .pcard {
    position: relative;
    display: block;
    border-right: 1px solid rgba(var(--text), 0.08);
    border-bottom: 1px solid rgba(var(--text), 0.08);
  }
  .pcard__image {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 3 / 4;
  }
  .pcard__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pcard__image-empty {
    aspect-ratio: 3 / 4;
    background: rgba(var(--text), 0.06);
  }

  /* ── Badges: discount top-left (black fill / white inside stroke /
     white regular-weight text); recently-viewed top-right in a neutral
     tone, same shape language, different color story. ── */
  .pcard__badge {
    position: absolute;
    top: 10px;
    z-index: 2;
    padding: 4px 8px;
    font-size: 10px;
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .pcard__badge--sale {
    left: 10px;
    background-color: #000000;
    color: #ffffff;
    box-shadow: inset 0 0 0 0.5px #ffffff;
  }
  .pcard__badge--viewed {
    right: 10px;
    background-color: rgba(var(--text), 0.85);
    color: rgb(var(--bg));
    box-shadow: inset 0 0 0 0.5px rgb(var(--bg));
  }
  .pcard__badge--viewed.hidden {
    display: none;
  }

  /* ── Info block ── */
  .pcard__info {
    padding: 12px 14px 14px;
  }
  .pcard__name-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .pcard__name {
    margin: 0 0 2px;
    font-size: 15px;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .pcard__name-code {
    font-weight: 700;
  }
  .pcard__name-type {
    font-weight: 500;
  }
  .pcard__material {
    margin: 0;
    font-size: 12px;
    font-weight: 400;
    color: rgba(var(--text), 0.55);
  }
  .pcard__foot {
    margin-top: 8px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 8px;
  }

  /* ── Price: sale/current price always brand red, whether or not
     there's a discount; compare-at stays grey + strikethrough (already
     conditional in product-grid-price.liquid); "From" prefix already
     conditional on price_varies there too. Sale and compare-at share the
     same font-size/weight/line-height so they sit on one visual line —
     only the color and strikethrough differ. ── */
  .pcard__price .price {
    gap: 6px !important;
    align-items: baseline !important;
  }
  .pcard__price .new-price {
    color: #923531;
    font-weight: 400;
    font-size: 12px;
    line-height: 1.2;
  }
  .pcard__price .new-price small {
    font-size: 10px;
    font-weight: 400;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #923531;
  }
  .pcard__price .old-price {
    color: rgba(var(--text), 0.45);
    font-size: 12px;
    font-weight: 400;
    line-height: 1.2;
    text-decoration: line-through;
  }

  /* ── Quick add: black circle, white plus ── */
  .pcard__quickadd.look__dot__button {
    position: static;
    width: 28px;
    height: 28px;
    margin: 0;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #000000;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .pcard__quickadd.look__dot__button::before,
  .pcard__quickadd.look__dot__button::after {
    background-color: #000000;
  }
  .pcard__quickadd .icon {
    stroke: #ffffff;
    width: 12px;
    height: 12px;
    position: relative;
    z-index: 1;
  }

  @media screen and (max-width: 749px) {
    .pcard__info {
      padding: 10px 10px 12px;
    }
    .pcard__name {
      font-size: 13px;
    }
    .pcard__material {
      font-size: 11px;
    }
    .pcard__price .new-price {
      font-size: 12px;
    }
  }
</style>
