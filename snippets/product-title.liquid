{%- assign onboarding_product = onboarding_product | default: false -%}
{%- liquid
  assign derived_material_label = blank
  assign display_title = product.title | strip_html

  unless onboarding_product
    # Align the product page name/material with the collection and predictive-search
    # cards. Line 1 is the display name with the material stripped out; line 2 is the
    # normalized material (TransDRY® keeps its casing and ®, everything else upper-cased),
    # or — for bundles — the list of included product names.
    assign pc_meta = product.metafields.custom.product_content.value
    assign direct_display_name = product.metafields.custom.display_name.value | strip_html | strip

    if direct_display_name != blank
      assign display_title = direct_display_name
    endif

    if pc_meta != blank
      assign meta_display_name = pc_meta.display_name.value | strip_html | strip
      if direct_display_name == blank and meta_display_name != blank
        assign display_title = meta_display_name
      endif
    endif

    # Strip the material out of the display name so it only appears on the second line
    assign title_material = product.metafields.theme.cutline.value | strip_html | strip
    if title_material != blank
      assign display_title = display_title | replace: title_material, '' | replace: 'TransDRY®', '' | replace: 'TRANSDRY®', '' | replace: 'TransDRY', '' | replace: 'TRANSDRY', '' | replace: '  ', ' ' | strip
    endif

    # Material label — same source and normalization as the cards (theme.cutline)
    assign product_card_source = product.type | append: ' ' | append: product.handle | append: ' ' | append: product.title | append: ' ' | append: product.tags | downcase
    assign is_bundle_product = false
    if product_card_source contains 'bundle'
      assign is_bundle_product = true
    endif

    assign derived_material_label = product.metafields.theme.cutline.value | strip_html | strip
    assign normalized_material_label = derived_material_label | downcase | remove: '®' | strip
    if normalized_material_label contains 'transdry'
      assign derived_material_label = 'TransDRY®'
    else
      assign derived_material_label = derived_material_label | upcase
    endif

    # Bundles: the second line lists the included product names instead of the material
    capture bundle_cutline
      if is_bundle_product
        assign bundle_product_single = product.metafields.theme.bundle
        assign bundle_product_list = product.metafields.theme.bundle_list
        assign bundle_name_count = 0

        if bundle_product_single.value != nil and bundle_product_single.type == 'product_reference'
          assign included_product = bundle_product_single.value
          assign included_name = included_product.metafields.custom.product_content.value.display_name.value | default: included_product.title | strip_html | strip
          assign included_material = included_product.metafields.theme.cutline.value | strip_html | strip
          if included_material != blank
            assign included_name = included_name | replace: included_material, '' | replace: 'TransDRY®', '' | replace: 'TRANSDRY®', '' | replace: 'TransDRY', '' | replace: 'TRANSDRY', '' | replace: '  ', ' ' | strip
          endif
          if included_name != blank
            echo included_name
            assign bundle_name_count = bundle_name_count | plus: 1
          endif
        endif

        if bundle_product_list.value != nil and bundle_product_list.type == 'list.product_reference'
          for included_product in bundle_product_list.value
            assign included_name = included_product.metafields.custom.product_content.value.display_name.value | default: included_product.title | strip_html | strip
            assign included_material = included_product.metafields.theme.cutline.value | strip_html | strip
            if included_material != blank
              assign included_name = included_name | replace: included_material, '' | replace: 'TransDRY®', '' | replace: 'TRANSDRY®', '' | replace: 'TransDRY', '' | replace: 'TRANSDRY', '' | replace: '  ', ' ' | strip
            endif
            if included_name != blank
              if bundle_name_count > 0
                echo ' · '
              endif
              echo included_name
              assign bundle_name_count = bundle_name_count | plus: 1
            endif
          endfor
        endif
      endif
    endcapture

    if is_bundle_product and bundle_cutline != blank
      assign derived_material_label = bundle_cutline
    endif
  endunless
-%}

{%- render 'stylesheet', name: 'breadcrumbs.css' -%}

<div
  class="product__block product__head block-padding"
  {{ block_style }}
  {% if animation_name %}
    data-animation="{{ animation_name }}"
    data-animation-duration="{{ animation_duration }}"
    data-animation-delay="{{ animation_delay }}"
  {% endif %}
>
  {%- case block.settings.subheading_option -%}
    {%- when 'vendor' -%}
      {%- if product.vendor -%}
        <nav class="breadcrumbs breadcrumbs--no-padding product__breadcrumbs">
          <a href="{{ product.vendor | url_for_vendor }}">{{ product.vendor }}</a>
        </nav>
      {%- endif -%}
    {%- when 'collection' -%}
      {%- if collection or product.collections.size > 0 -%}
        {%- assign current_collection = collection | default: product.collections[0] -%}

        <nav class="breadcrumbs breadcrumbs--no-padding product__breadcrumbs">
          <a href="{{ current_collection.url }}">{{ current_collection.title }}</a>
        </nav>
      {%- endif -%}
    {%- when 'breadcrumb' -%}
      {% render 'breadcrumbs', breadcrumbs_modifier: 'breadcrumbs--no-padding product__breadcrumbs' %}
  {%- endcase -%}

  <div class="product__title__wrapper" {{ block.shopify_attributes }}>
    <h1 class="product__title {{ block.settings.heading_font_size | default: 'heading-small' }}">
      {%- if onboarding_product -%}
        <span data-zoom-caption>{{ 'home_page.onboarding.product_title' | t }}</span>
      {%- else -%}
        {%- unless is_title_linked -%}
          <span data-zoom-caption>{{ display_title | strip_html }}</span>
        {%- else -%}
          <a href="{{ product.url }}">
            <span data-zoom-caption>{{ display_title | strip_html }}</span>
          </a>
        {%- endunless -%}
      {%- endif -%}
    </h1>

    {%- if derived_material_label != blank -%}
      <p class="product__title__material">{{ derived_material_label }}</p>
    {%- endif -%}
  </div>
</div>
