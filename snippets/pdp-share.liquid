{%- comment -%}
  PDP share control. Mobile: native Web Share API. Desktop / no-share:
  inline row of WhatsApp · Telegram · Facebook · X · Copy Link (SG audience
  → WhatsApp + Telegram first). No third-party widgets or scripts.
  Accepts: share_url (String), share_title (String, optional).
{%- endcomment -%}

{%- liquid
  assign pdp_share_url = share_url | default: request.origin | append: product.url
  assign pdp_share_title = share_title | default: product.title | strip_html
  assign pdp_share_uid = section.id | append: '-' | append: block.id
-%}

<pdp-share class="pdp-share" data-share-url="{{ pdp_share_url }}" data-share-title="{{ pdp_share_title | escape }}">
  {%- comment -%} Native share trigger — shown only when navigator.share exists (JS toggles [hidden]). {%- endcomment -%}
  <button type="button" class="pdp-share__native" data-pdp-share-native hidden>
    <svg class="pdp-share__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
      <path d="M18 8a3 3 0 1 0-2.83-4H15a3 3 0 0 0 .17 1L8.83 8.6A3 3 0 1 0 6 13.4l6.34 3.6A3 3 0 1 0 15 15.4L8.66 11.8a3 3 0 0 0 0-1.6L15 6.6A3 3 0 0 0 18 8Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
    </svg>
    <span>{{ 'general.share.share' | t | default: 'Share' }}</span>
  </button>

  {%- comment -%} Fallback inline row — the default; native trigger replaces it when available. {%- endcomment -%}
  <div class="pdp-share__row" data-pdp-share-row>
    <span class="pdp-share__label">{{ 'general.share.share' | t | default: 'Share' }}</span>

    <a class="pdp-share__link" data-pdp-share="whatsapp" target="_blank" rel="noopener" aria-label="Share on WhatsApp"
       href="https://api.whatsapp.com/send?text={{ pdp_share_title | append: ' ' | append: pdp_share_url | url_encode }}">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.05L2 22l5.1-1.34A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.03.8.81-2.95-.2-.31A8.2 8.2 0 1 1 12 20.2Zm4.5-6.14c-.25-.12-1.46-.72-1.69-.8-.23-.09-.39-.13-.56.12-.16.25-.64.8-.78.97-.14.16-.29.18-.54.06a6.7 6.7 0 0 1-3.3-2.9c-.25-.42.25-.39.71-1.3.08-.16.04-.3-.02-.42-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.41-.56-.42h-.48c-.16 0-.42.06-.64.3-.22.25-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.64 1.53.66 2.13.72 2.9.6.46-.06 1.46-.6 1.66-1.18.2-.58.2-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z"/></svg>
    </a>

    <a class="pdp-share__link" data-pdp-share="telegram" target="_blank" rel="noopener" aria-label="Share on Telegram"
       href="https://t.me/share/url?url={{ pdp_share_url | url_encode }}&text={{ pdp_share_title | url_encode }}">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M21.94 4.6 18.9 19.2c-.23 1.02-.84 1.27-1.7.79l-4.7-3.47-2.27 2.19c-.25.25-.46.46-.94.46l.33-4.77 8.68-7.84c.38-.34-.08-.53-.59-.19l-10.73 6.76-4.62-1.45c-1-.31-1.02-1 .21-1.48l18.06-6.96c.84-.31 1.57.19 1.3 1.56Z"/></svg>
    </a>

    <a class="pdp-share__link" data-pdp-share="facebook" target="_blank" rel="noopener" aria-label="Share on Facebook"
       href="https://www.facebook.com/sharer/sharer.php?u={{ pdp_share_url | url_encode }}">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-8h2.6l.4-3h-3V8.1c0-.87.24-1.46 1.5-1.46H17V4.03A20.5 20.5 0 0 0 14.7 3.9c-2.32 0-3.9 1.42-3.9 4.02V10H8.2v3h2.6v8h2.7Z"/></svg>
    </a>

    <a class="pdp-share__link" data-pdp-share="x" target="_blank" rel="noopener" aria-label="Share on X"
       href="https://twitter.com/intent/tweet?url={{ pdp_share_url | url_encode }}&text={{ pdp_share_title | url_encode }}">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M17.5 3h3.1l-6.77 7.74L21.8 21h-6.2l-4.86-6.35L5.2 21H2.1l7.24-8.28L2.5 3h6.36l4.4 5.8L17.5 3Zm-1.09 16.15h1.72L7.66 4.76H5.82l10.59 14.39Z"/></svg>
    </a>

    <button type="button" class="pdp-share__link pdp-share__copy" data-pdp-share-copy aria-label="Copy link">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="M9 15a3 3 0 0 1 0-4.24l3-3a3 3 0 0 1 4.24 4.24l-1.2 1.2M15 9a3 3 0 0 1 0 4.24l-3 3A3 3 0 0 1 7.76 12l1.2-1.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span class="pdp-share__copy-label" data-pdp-share-copy-label>Copy Link</span>
    </button>
  </div>
</pdp-share>

<style>
  .pdp-share { display: block; }
  .pdp-share__row,
  .pdp-share__native {
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }
  .pdp-share__native {
    appearance: none;
    background: none;
    border: 0;
    padding: 8px 0;
    min-height: 44px;
    font-size: 14px;
    color: #1D1D1F;
    cursor: pointer;
  }
  .pdp-share__label {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #86868B;
    margin-right: 2px;
  }
  .pdp-share__link {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 44px;
    min-height: 44px;
    justify-content: center;
    color: #1D1D1F;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  .pdp-share__link:hover { opacity: 0.6; }
  .pdp-share__link:focus-visible {
    outline: 2px solid var(--focus, #1D1D1F);
    outline-offset: 3px;
    border-radius: 2px;
  }
  .pdp-share__copy { min-width: auto; }
  .pdp-share__copy-label { font-size: 13px; }
  .pdp-share__copy.is-copied .pdp-share__copy-label { color: #86868B; }
</style>

<script src="{{ 'pdp-share.js' | asset_url }}" defer="defer"></script>
