{%- comment -%}
  PDP share control — one clean row of uniform icons.
  WhatsApp · Telegram · Facebook · Instagram · X. No native Web Share sheet,
  no "SHARE" eyebrow, no Copy Link. Instagram opens the brand profile
  (no public share intent URL exists).
  Accepts: share_url (String), share_title (String, optional).
{%- endcomment -%}

{%- liquid
  assign pdp_share_url = share_url | default: request.origin | append: product.url
  assign pdp_share_title = share_title | default: product.title | strip_html
  assign pdp_ig_url = block.settings.ig_url | default: 'https://instagram.com/triiiplestudio'
-%}

<pdp-share class="pdp-share" data-share-url="{{ pdp_share_url }}" data-share-title="{{ pdp_share_title | escape }}">
  <div class="pdp-share__row" data-pdp-share-row>
    <a class="pdp-share__link" data-pdp-share="whatsapp" target="_blank" rel="noopener" aria-label="Share on WhatsApp"
       href="https://api.whatsapp.com/send?text={{ pdp_share_title | append: ' ' | append: pdp_share_url | url_encode }}">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.05L2 22l5.1-1.34A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.03.8.81-2.95-.2-.31A8.2 8.2 0 1 1 12 20.2Zm4.5-6.14c-.25-.12-1.46-.72-1.69-.8-.23-.09-.39-.13-.56.12-.16.25-.64.8-.78.97-.14.16-.29.18-.54.06a6.7 6.7 0 0 1-3.3-2.9c-.25-.42.25-.39.71-1.3.08-.16.04-.3-.02-.42-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.41-.56-.42h-.48c-.16 0-.42.06-.64.3-.22.25-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.64 1.53.66 2.13.72 2.9.6.46-.06 1.46-.6 1.66-1.18.2-.58.2-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z"/></svg>
    </a>

    <a class="pdp-share__link" data-pdp-share="telegram" target="_blank" rel="noopener" aria-label="Share on Telegram"
       href="https://t.me/share/url?url={{ pdp_share_url | url_encode }}&text={{ pdp_share_title | url_encode }}">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M21.94 4.6 18.9 19.2c-.23 1.02-.84 1.27-1.7.79l-4.7-3.47-2.27 2.19c-.25.25-.46.46-.94.46l.33-4.77 8.68-7.84c.38-.34-.08-.53-.59-.19l-10.73 6.76-4.62-1.45c-1-.31-1.02-1 .21-1.48l18.06-6.96c.84-.31 1.57.19 1.3 1.56Z"/></svg>
    </a>

    <a class="pdp-share__link" data-pdp-share="facebook" target="_blank" rel="noopener" aria-label="Share on Facebook"
       href="https://www.facebook.com/sharer/sharer.php?u={{ pdp_share_url | url_encode }}">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M13.5 21v-8h2.6l.4-3h-3V8.1c0-.87.24-1.46 1.5-1.46H17V4.03A20.5 20.5 0 0 0 14.7 3.9c-2.32 0-3.9 1.42-3.9 4.02V10H8.2v3h2.6v8h2.7Z"/></svg>
    </a>

    <a class="pdp-share__link" data-pdp-share="instagram" target="_blank" rel="noopener" aria-label="Open Instagram"
       href="{{ pdp_ig_url }}">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.6"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor"/></svg>
    </a>

    <a class="pdp-share__link" data-pdp-share="x" target="_blank" rel="noopener" aria-label="Share on X"
       href="https://twitter.com/intent/tweet?url={{ pdp_share_url | url_encode }}&text={{ pdp_share_title | url_encode }}">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M17.5 3h3.1l-6.77 7.74L21.8 21h-6.2l-4.86-6.35L5.2 21H2.1l7.24-8.28L2.5 3h6.36l4.4 5.8L17.5 3Zm-1.09 16.15h1.72L7.66 4.76H5.82l10.59 14.39Z"/></svg>
    </a>
  </div>
</pdp-share>

<style>
  .pdp-share { display: block; }
  .pdp-share__row {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    gap: 20px;
  }
  .pdp-share__link {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    color: #1D1D1F;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  .pdp-share__link:hover { opacity: 0.6; }
  .pdp-share__link:focus-visible {
    outline: 2px solid var(--focus, #1D1D1F);
    outline-offset: 3px;
    border-radius: 2px;
  }
</style>

<script src="{{ 'pdp-share.js' | asset_url }}" defer="defer"></script>
