{%- comment -%}
  Renders a single bullet line, bolding any registered-trademark term
  (e.g. TransDRY®) as the lead-in. All other words stay regular weight.
  Usage: {%- render 'pdp-bullet-emphasis', text: bullet_string -%}
{%- endcomment -%}
{%- assign pdp_words = text | split: ' ' -%}
{%- for pdp_word in pdp_words -%}
{%- if pdp_word contains '®' -%}<strong>{{ pdp_word }}</strong>{%- else -%}{{ pdp_word }}{%- endif -%}{%- unless forloop.last %} {% endunless -%}
{%- endfor -%}
