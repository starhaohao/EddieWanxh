{%- liquid
  assign featured_product = featured_product | default: false
  assign onboarding_product = false
  assign current_variant = product.selected_or_first_available_variant
  assign product_sticky_enable = section.settings.product_sticky_enable
  assign enable_video_looping = section.settings.enable_video_looping
  assign enable_history_state = true
  assign image_size = section.settings.image_size | default: 'normal'
  assign image_layout = section.settings.image_layout
  assign mobile_image_style = section.settings.mobile_image_style
  assign featured_media = current_variant.featured_media | default: product.featured_media
  assign featured_media_aspect_ratio = featured_media.aspect_ratio | default: 1
  comment
    TEMP PATCH — taller product image.
    The image container height follows this ratio (width / height), so a
    smaller number = taller image. The photo's own natural ratio was making
    the container short, leaving a big gap before the vendor/title text.
    0.75 = 3:4 portrait. Try 0.7 for even taller, or remove this override
    entirely to go back to each photo's natural ratio.
  endcomment
  assign featured_media_aspect_ratio = 0.75
  assign is_title_linked = true
  if template.name == 'product' and featured_product == false
    assign is_title_linked = false
  endif

  if product.empty?
    assign onboarding_product = true
  endif

  if featured_product
    assign product_sticky_enable = false
    assign enable_history_state = false
  endif

  assign show_thumbnails = false
  assign enable_thumbs = false
  assign enable_thumbs_mobile = false

  if image_layout == 'thumbnails' or image_layout == 'thumbnails-left'
    assign enable_thumbs = true
    assign show_thumbnails = true
  endif

  if mobile_image_style == 'thumbs'
    assign show_thumbnails = true
    assign enable_thumbs_mobile = true
  endif

  if product.media.size <= 1
    assign show_thumbnails = false
  endif

  assign modifier = image_layout | default: 'thumbnails'
  assign product_wrapper_modifier = 'product__wrapper--' | append: modifier

  assign wrapper_tag = 'div'
  if product_sticky_enable
    assign wrapper_tag = 'product-sticky'
  endif

  assign show_buy_buttons = false
  assign buy_buttons = section.blocks | where: 'type', 'buttons'

  if buy_buttons.size > 0
    assign show_buy_buttons = true
  endif

  assign image_width = 770

  if image_size == 'small'
    assign product_wrapper_modifier = product_wrapper_modifier | append: ' product__wrapper--small'
    assign image_width = 525
  endif

  if image_size == 'stretch'
    assign product_wrapper_modifier = product_wrapper_modifier | append: ' product__wrapper--stretch'
    assign image_width = 970
  endif

  assign product_form_id = 'product-form-' | append: section.id
  assign show_cart_bar = false

  assign sibling_color = product.metafields.theme.sibling_color.value | default: product.metafields.theme.sibling_colour.value | default: product.metafields.theme.siblings_color.value | default: product.metafields.theme.siblings_colour.value | default: product.metafields.theme.siblings_colors.value | default: product.metafields.theme.siblings_colours.value

  if section.settings.show_cart_bar and featured_product == false
    assign show_cart_bar = true
  endif

  capture product_images_classlist
    echo 'product__images'

    if enable_thumbs
      echo ' product__images--thumbs'
    else
      echo ' product__images--no-thumbs'
    endif

    if enable_thumbs_mobile
      echo ' product__images--mobile-thumbs'
    else
      echo ' product__images--mobile-slider'
    endif
  endcapture

  assign preorder = false
  if product.metafields.theme.preorder.type == 'boolean' and product.metafields.theme.preorder.value == true
    assign preorder = true
  endif

  if current_variant.metafields.theme.preorder.type == 'boolean' and current_variant.metafields.theme.preorder.value == true
    assign preorder = true
  endif

  assign product_tags = product.tags | join: ','
  if product_tags contains '_preorder'
    assign preorder = true
  endif

  assign on_sale = false
  assign sale_percent = blank
  if current_variant.compare_at_price > current_variant.price
    assign on_sale = true
    assign sale_percent = current_variant.compare_at_price | minus: current_variant.price | times: 100.0 | divided_by: current_variant.compare_at_price | round
  endif

  assign badge = ''
  if badge == '' and product_tags contains '_badge_'
    assign badge = product_tags | split: '_badge_'
    assign badge = badge[1] | split: ',' | first | replace: '_', ' '
  endif

  assign product_badge_source = product.type | append: ' ' | append: product.handle | append: ' ' | append: product.title | append: ' ' | append: product_tags | downcase
  assign product_family_badge = ''

  if product_badge_source contains 'bundle'
    assign product_family_badge = 'Bundle'
  elsif product_badge_source contains 'boxer' or product_badge_source contains 'trunk'
    assign product_family_badge = 'Boxer Trunks'
  elsif product_badge_source contains 'brief'
    assign product_family_badge = 'Brief'
  elsif product_badge_source contains 'sock'
    assign product_family_badge = 'Socks'
  elsif product_badge_source contains 't-shirt' or product_badge_source contains 'tshirt' or product_badge_source contains 'tee'
    assign product_family_badge = 'T-Shirt'
  elsif product_badge_source contains 'sleeveless' or product_badge_source contains 'top'
    assign product_family_badge = 'Top'
  endif

  comment
    Material badge(s), shown on ALL products from theme.cutline.
    A cutline naming both fabrics splits into two badges:
    COTTON SPANDEX + TransDRY®. Same normalization used everywhere:
    contains 'transdry' -> 'TransDRY®'; anything else -> UPPERCASE.
  endcomment
  assign product_material_badge = ''
  assign product_material_badge_2 = ''
  assign raw_cutline = product.metafields.theme.cutline.value | strip_html | strip
  assign normalized_cutline = raw_cutline | downcase | remove: '®' | strip

  if raw_cutline != blank
    assign has_transdry = false
    assign has_cotton = false
    if normalized_cutline contains 'transdry'
      assign has_transdry = true
    endif
    if normalized_cutline contains 'cotton' or normalized_cutline contains 'spandex'
      assign has_cotton = true
    endif

    if has_transdry and has_cotton
      assign product_material_badge = 'COTTON SPANDEX'
      assign product_material_badge_2 = 'TransDRY®'
    elsif has_transdry
      assign product_material_badge = 'TransDRY®'
    else
      assign product_material_badge = raw_cutline | upcase
    endif
  endif

  comment
    Line 2 under the title. Single products only: the material label.
    Bundles get their Line 2 (included product names) inside product-title
    via product_content / bundle_list, so leave title_material blank for them.
  endcomment
  assign title_material = ''
  unless product_badge_source contains 'bundle'
    if normalized_cutline contains 'transdry' and normalized_cutline contains 'cotton'
      assign title_material = 'COTTON SPANDEX & TransDRY®'
    elsif normalized_cutline contains 'transdry'
      assign title_material = 'TransDRY®'
    elsif raw_cutline != blank
      assign title_material = raw_cutline | upcase
    endif
  endunless

  assign color_scheme = 'color-' | append: section.settings.color_scheme
-%}

{{ 'product.css' | asset_url | stylesheet_tag }}

<product-info
  id="MainProduct--{{ section.id }}"
  class="index-product section-padding {{ color_scheme }}"
  data-section="{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-product-handle="{{ product.handle }}"
  data-product-id="{{ product.id }}"
  data-enable-history-state="{{ enable_history_state }}"
  data-url="{{ product.url }}"
  data-overlay-header
  data-sticky-enabled="{{ product_sticky_enable }}"
  data-variant-image-scroll="{{ section.settings.variant_image_scroll }}"
>
  {%- style -%}
    {%- if show_cart_bar -%}
      :root { --cart-bar-height: 80px; }
    {%- endif -%}

    #MainProduct--{{ section.id }} {
      --PT: {{ section.settings.padding_top }}px;
      --PB: {{ section.settings.padding_bottom }}px;

      --swatch-size: var(--swatch-size-product);
    }

    /* Badge overlay: this theme ships no base `.product__media-badges`
       rule, so pin the container over the top-left of the product image
       instead of letting it sit in normal flow (which pushed a white band
       above the image on mobile). */
    #MainProduct--{{ section.id }} product-images {
      position: relative;
      display: block;
    }
    #MainProduct--{{ section.id }} .product__media-badges {
      position: absolute;
      top: 16px;
      left: 12px;
      right: 12px;
      z-index: 4;
      margin: 0;
      display: flex;
      flex-flow: row wrap;
      gap: 6px;
      width: auto;
      pointer-events: none;
    }
    @media screen and (max-width: 749px) {
      #MainProduct--{{ section.id }} .product__media-badges {
        top: 10px;
        left: 10px;
        right: 10px;
        gap: 5px;
      }
    }
  {%- endstyle -%}

  {%- comment -%}
    CDLP-style dimension retrofit. Scoped to this product section only.
    Enforces a 50/50 desktop split with a centered 480px text column, the
    editorial type scale, 48px size squares, a full-width black Add-to-Bag,
    styled accordions, and mobile spacing + a 64px sticky cart-bar. The
    media gallery is intentionally left to the theme's own product.css
    (already flush / full-height cover on desktop, edge-to-edge 3:4 on
    mobile). Prices keep the brand neon-yellow treatment, so no price
    colors are set here.
  {%- endcomment -%}
  {%- style -%}
    /* ================= DESKTOP (>=990px): 50/50 split ================= */
    @media only screen and (min-width: 990px) {
      #MainProduct--{{ section.id }} .product__page {
        grid-template-columns: 50% 50%;
        gap: 0;
      }

      /* Right: 480px content column with generous padding.
         The media column deliberately keeps the theme's tuned flush /
         full-height stacked-cover treatment from product.css — overriding
         it here would clamp the stacked gallery to one viewport height. */
      #MainProduct--{{ section.id }} .product__content {
        padding: 40px;
      }
      #MainProduct--{{ section.id }} .product__content .form__width {
        max-width: 480px;
        width: 100%;
        margin: 0 auto;
      }
    }
    /* Wider right gutter on large screens (spec: 40–80px) */
    @media only screen and (min-width: 1400px) {
      #MainProduct--{{ section.id }} .product__content { padding: 40px 80px; }
    }

    /* ================= Editorial type scale ================= */
    #MainProduct--{{ section.id }} .product__breadcrumbs {
      font-size: 16px;
      font-weight: 700;
      letter-spacing: 0.08em;
    }
    #MainProduct--{{ section.id }} .product__title {
      font-size: 32px !important;
      font-weight: 700;
      line-height: 1.05;
      letter-spacing: -0.015em;
      margin-bottom: 6px;
    }
    /* Material line: stays a small tracked-cap label under the now-bolder,
       larger title — pinned with !important on font-size so it can't be
       outsized by a per-block heading-size setting the way it was before. */
    #MainProduct--{{ section.id }} .product__subheading {
      font-size: 13px !important;
      font-weight: 500;
      line-height: 1.3;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: rgba(0, 0, 0, 0.5);
    }
    #MainProduct--{{ section.id }} .product__price__wrap,
    #MainProduct--{{ section.id }} .product__price {
      font-size: 14px;
      font-weight: 500;
      letter-spacing: 0;
      margin-bottom: 32px;
    }

    /* ================= Size selector: 48px squares ================= */
    #MainProduct--{{ section.id }} .radio__button label {
      min-width: 48px;
      height: 48px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      letter-spacing: 0.04em;
      border: 1px solid #E5E5E5;
      transition: background-color 0.2s ease;
    }
    @media (hover: hover) {
      #MainProduct--{{ section.id }} .radio__button label:hover {
        background-color: #F0F0F0;
      }
    }

    /* ================= Add to Bag: full-width black, 56px =================
       Scoped to the main submit button so upsell / quick-add buttons that
       may render inside the product section are left untouched. */
    #MainProduct--{{ section.id }} .product__submit__item [data-add-to-cart] {
      width: 100%;
      height: 56px;
      min-height: 56px;
      background: #000;
      color: #fff;
      font-size: 14px;
      font-weight: 500;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      margin-top: 32px;
      transition: opacity 0.2s ease, transform 0.2s ease;
    }
    #MainProduct--{{ section.id }} .product__submit__item [data-add-to-cart]:not([disabled]):hover {
      opacity: 0.8;
      transform: scale(0.98);
    }

    /* ================= Quantity selector: full-width above ATC ==============
       Store is on quantity_style = "dropdown" — theme hides the stepper
       by default via `.select-popout + .quantity { display: none }` and
       reveals it only when the shopper picks 10+ (theme adds `.is-active`).
       Prior grid override forced the hidden stepper to render, producing a
       duplicate "1" between the dropdown and ATC (Eddie 2026-07-23 review).
       Now we only style the stepper — never force it visible. */
    #MainProduct--{{ section.id }} .product__submit__item--inline {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      width: 100%;
    }
    #MainProduct--{{ section.id }} .product__submit__item--inline .product-form__quantity {
      width: 100%;
      margin: 0;
    }
    /* Ensure the quantity-input custom element (which wraps both the
       dropdown and the stepper) spans the full width so the dropdown
       toggle stretches edge-to-edge, matching the black ATC below. */
    #MainProduct--{{ section.id }} .product-form__quantity quantity-input {
      display: block;
      width: 100%;
    }
    #MainProduct--{{ section.id }} .product-form__quantity .select-popout--quantity,
    #MainProduct--{{ section.id }} .product-form__quantity .select-popout--quantity .select-popout__toggle {
      width: 100%;
      height: 48px;
    }
    /* Style the stepper for the case it IS revealed (dropdown active or
       standard quantity_style). Layout properties without display so the
       theme's toggle stays authoritative. */
    #MainProduct--{{ section.id }} .product-form__quantity .quantity {
      grid-template-columns: 48px 1fr 48px;
      align-items: center;
      width: 100%;
      height: 48px;
      border: 1px solid #E5E5E5;
      background: transparent;
    }
    /* Only turn on grid display when the stepper is actually meant to be
       visible — either the dropdown flipped to .is-active, or there's no
       dropdown at all. */
    #MainProduct--{{ section.id }} .product-form__quantity .select-popout.is-active + .quantity {
      display: grid;
    }
    #MainProduct--{{ section.id }} .product-form__quantity .quantity__button {
      min-width: 44px;
      min-height: 44px;
      height: 100%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: none;
      border: 0;
      color: #1D1D1F;
      cursor: pointer;
    }
    #MainProduct--{{ section.id }} .product-form__quantity .quantity__button svg {
      width: 14px;
      height: 14px;
    }
    #MainProduct--{{ section.id }} .product-form__quantity .quantity__input {
      height: 100%;
      border: 0;
      border-left: 1px solid #E5E5E5;
      border-right: 1px solid #E5E5E5;
      background: transparent;
      text-align: center;
      font-size: 15px;
      color: #1D1D1F;
      -moz-appearance: textfield;
      appearance: textfield;
    }
    #MainProduct--{{ section.id }} .product-form__quantity .quantity__input::-webkit-outer-spin-button,
    #MainProduct--{{ section.id }} .product-form__quantity .quantity__input::-webkit-inner-spin-button {
      -webkit-appearance: none;
      margin: 0;
    }
    #MainProduct--{{ section.id }} .product__submit__item--inline [data-add-to-cart] {
      margin-top: 12px;
    }

    /* ================= Accordions ================= */
    #MainProduct--{{ section.id }} .accordion {
      border-top: 1px solid #E5E5E5;
    }
    #MainProduct--{{ section.id }} .accordion__title {
      padding: 16px 0;
      font-size: 13px;
      letter-spacing: 0.01em;
    }

    /* Sale badge inset per spec (keeps the brand neon pill styling) */
    #MainProduct--{{ section.id }} .product__media-badges { top: 24px; left: 24px; }

    /* "Final sale" label: brand orange (matches theme's sale_color). */
    #MainProduct--{{ section.id }} .product__final-sale,
    #MainProduct--{{ section.id }} .product__final-sale-question {
      color: #ED813E !important;
    }

    /* Promo socks upsell card: title matches the material-line size, price
       and the shared info line render as three separate lines. */
    #MainProduct--{{ section.id }} [data-promo-socks-offer] .product-upsell__title {
      font-size: 13px;
      font-weight: 400;
      letter-spacing: 0.01em;
    }
    #MainProduct--{{ section.id }} [data-promo-socks-offer] .product-upsell__price .new-price {
      color: #ED813E;
    }

    /* Media badges: halve the pill height (thinner than the base badge-box)
       and center the label both axes. Border thinned to 1px inline. Same
       padding/border used on the collection card badges so they match. */
    #MainProduct--{{ section.id }} .product__media-badge {
      --padding-vertical: 0.22rem;
      padding-top: 0.22rem;
      padding-bottom: 0.22rem;
      line-height: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    /* Before + after price on one row (was stacking on mobile). */
    #MainProduct--{{ section.id }} .price__sale {
      display: flex;
      flex-flow: row wrap;
      align-items: baseline;
      gap: 8px;
    }

    /* Mobile: the sticky cart-bar at the bottom already renders one compare-at
       strike. Hide the inline black-strike inside the PDP sale block so only
       one "before + after" pair shows on mobile (Eddie 2026-07-22 review). */
    @media only screen and (max-width: 749px) {
      #MainProduct--{{ section.id }} .price__sale s.price-item--regular {
        display: none;
      }
    }

    /* Halve the empty mobile thumbnail-strip gap before the vendor/title. */
    @media only screen and (max-width: 749px) {
      #MainProduct--{{ section.id }} .product__thumbs {
        min-height: 42px;
        margin: 5px 0;
      }
    }

    /* Below desktop (<=989px): stack the page and make the media full-bleed
       edge-to-edge, overriding the theme's gutter-based margins. */
    @media only screen and (max-width: 989px) {
      #MainProduct--{{ section.id }} .product__page {
        display: block !important;
      }
      #MainProduct--{{ section.id }} .product__images {
        width: 100vw !important;
        max-width: 100vw !important;
        margin-left: calc(50% - 50vw) !important;
        margin-right: calc(50% - 50vw) !important;
      }
    }

    /* ================= MOBILE (<=749px): unified stack ================= */
    @media only screen and (max-width: 749px) {
      /* Media column keeps the theme's edge-to-edge 3:4 treatment. */
      #MainProduct--{{ section.id }} .product__content {
        padding: 24px 16px 120px 16px;
      }
      #MainProduct--{{ section.id }} .product__title {
        font-size: 24px !important;
        letter-spacing: -0.01em;
      }
      #MainProduct--{{ section.id }} .product__subheading {
        font-size: 12px !important;
      }
      #MainProduct--{{ section.id }} .product__price__wrap,
      #MainProduct--{{ section.id }} .product__price {
        margin-bottom: 24px;
      }
      #MainProduct--{{ section.id }} .radio__button label {
        min-width: 44px;
        height: 44px;
      }
      #MainProduct--{{ section.id }} .product__media-badges { top: 16px; left: 16px; }
    }

    /* Mobile sticky Add-to-Bag: the theme's own cart-bar, sized to spec */
    @media only screen and (max-width: 749px) {
      .cart-bar {
        min-height: 64px;
        padding-bottom: env(safe-area-inset-bottom);
        z-index: 50;
      }
    }

    /* Liquid glass: mobile sticky Add-to-Bag bar.
       Same recipe as the header/footer glass in layout/theme.liquid — reuses
       the shared --glass-grain texture and #liquid-glass-distortion SVG
       filter defined there, with the same brightened white-wash tuning.
       Gated so browsers without backdrop-filter keep the bar's solid
       var(--bg) fill untouched. */
    @supports ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) and (color: color-mix(in srgb, red 50%, transparent)) {
      .cart-bar {
        background-color: color-mix(in srgb, var(--bg, #fff) 28%, transparent);
        background-image:
          linear-gradient(rgba(255, 255, 255, 0.4), rgba(255, 255, 255, 0.4)),
          var(--glass-grain);
        -webkit-backdrop-filter: blur(11px) saturate(160%) brightness(1.15);
        backdrop-filter: blur(11px) saturate(160%) brightness(1.15) url(#liquid-glass-distortion);
        box-shadow:
          inset 0 1px 0 rgba(255, 255, 255, 0.7),
          0 -8px 24px -16px rgba(0, 0, 0, 0.18);
      }
      .cart-bar__product__title,
      .cart-bar__product__price {
        filter: drop-shadow(0 1px 1px rgba(255, 255, 255, 0.5));
      }
    }
  {%- endstyle -%}

  <{{ wrapper_tag }} class="product__wrapper {{ product_wrapper_modifier }}" data-product>
    <div class="{% if featured_product %}{{ section.settings.width }}{% else %}product__wrapper__inner{% endif %}">
      <div class="product__page">
        <product-images
          class="{{ product_images_classlist }}"
          data-active-media="{{ section.id }}-{{ featured_media.id }}"
          {% if enable_thumbs %}
            data-fader-desktop
          {% endif %}
          {% if enable_thumbs_mobile %}
            data-fader-mobile
          {% endif %}
        >
          {%- if product_family_badge != blank or product_material_badge != blank or product_material_badge_2 != blank or on_sale -%}
            {%- comment -%}
              Badge overlay. This theme has NO base .product__media-badges
              rule, so the container is positioned by the scoped CSS in the
              section style block above (absolute, top-left of the image).
              Only the neon fill token is passed inline here.
            {%- endcomment -%}
            <div
              class="product__media-badges {{ settings.badge_font_size }}"
              aria-label="Product details"
              style="--triiiple-neon: #EFFF00;"
            >
              {%- if product_family_badge != blank -%}
                <span
                  class="badge-box category-box product__media-badge product__media-badge--left"
                  style="border: 1px solid #000 !important; color: #000 !important;"
                >
                  {{ product_family_badge }}
                </span>
              {%- endif -%}
              {%- comment -%} Sale %: percentage only, never the word "Sale". Shows whenever marked down. {%- endcomment -%}
              {%- if on_sale and product.available and sale_percent != blank -%}
                <span
                  class="badge-box sale-box product__media-badge product__media-badge--left"
                  style="
                    background-color: var(--triiiple-neon) !important;
                    border: 1px solid #000 !important;
                    color: #000 !important;
                  "
                >
                  {{ sale_percent }}%
                </span>
              {%- endif -%}
              {%- if product_material_badge != blank -%}
                <span
                  class="badge-box product__media-badge product__media-badge--right"
                  style="border: 1px solid #000 !important; color: #000 !important;"
                >
                  {{ product_material_badge }}
                </span>
              {%- endif -%}
              {%- if product_material_badge_2 != blank -%}
                <span
                  class="badge-box product__media-badge product__media-badge--right"
                  style="border: 1px solid #000 !important; color: #000 !important;"
                >
                  {{ product_material_badge_2 }}
                </span>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if product.media.size > 0 -%}
            {%- capture product_slides_attributes -%}
              class="product__slides product-single__photos"
              style="--featured-media-aspect-ratio: {{ featured_media_aspect_ratio | round: 2 }};"
              data-product-media-list
            {%- endcapture -%}

            {%- if section.settings.enable_zoom -%}
              <zoom-images {{ product_slides_attributes }}>
            {%- else -%}
              <div {{ product_slides_attributes }}>
            {%- endif -%}

            {%- for media in product.media -%}
              {%- render 'media',
                media: media,
                featured_media: featured_media,
                enable_video_looping: enable_video_looping,
                sectionkey: section.id,
                image_width: image_width,
                cover: true
              -%}
            {%- endfor -%}

            {%- if section.settings.enable_zoom -%}
              </zoom-images>

              <script src="{{ 'load-photoswipe.js' | asset_url }}" defer="defer"></script>
              <script src="{{ 'zoom.js' | asset_url }}" defer="defer"></script>
            {%- else -%}
              </div>
            {%- endif -%}

            {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
            {%- if first_3d_model -%}
              <link
                id="ModelViewerStyle"
                rel="stylesheet"
                href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
                media="print"
                onload="this.media='all'"
              >
            {%- endif -%}
            {%- if first_3d_model -%}
              <button
                class="btn btn--outline btn--black btn--ar product-single__view-in-space"
                data-shopify-xr
                data-shopify-model3d-id="{{ first_3d_model.id }}"
                data-shopify-title="{{ product.title | strip_html }}"
                data-shopify-xr-hidden
              >
                {%- render 'icon-media-model' -%}

                <span class="product-single__view-in-space-text">{{ 'products.general.view_space' | t }}</span>
              </button>
            {%- endif -%}

            {%- if show_thumbnails -%}
              <product-thumbs class="product__thumbs product__thumbs--lines">
                <div class="product__thumbs__holder" data-thumbs-slider>
                  {%- for media in product.media -%}
                    <div class="product__thumb{% if media == featured_media %} is-active{% endif %}" data-thumb-item>
                      <a
                        class="product__thumb__link"
                        href="{{ media.preview_image.src | image_url }}"
                        aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                        data-media-id="{{ section.id }}-{{ media.id }}"
                        data-thumb-link
                      ><span class="product__thumb__line"></span></a>
                    </div>
                  {%- endfor -%}
                </div>
              </product-thumbs>
            {%- endif -%}

            {%- comment -%} Thumbnails template for Photoswipe {%- endcomment -%}
            {%- if section.settings.enable_zoom -%}
              <template data-pswp-thumbs-template>
                {%- assign images = product.media | where: 'media_type', 'image' -%}

                {%- for image in images -%}
                  {%- render 'image',
                    image: image,
                    width: 160,
                    height: 160,
                    sizes: '80px',
                    widths: '80, 120, 160',
                    aspect_ratio: 1,
                    modifier: 'pswp__thumb'
                  -%}
                {%- endfor -%}
              </template>
            {%- endif -%}
          {%- elsif onboarding_product == false -%}
            <div class="product__slides product__slides--{{ image_size }} product-single__photos">
              <div
                class="product__photo product__slide product__photo--blank"
              >
                {%- if onboarding_product -%}
                  {{ 'product-1' | placeholder_svg_tag: 'svg-placeholder' }}
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

          {%- if onboarding_product -%}
            <div
              class="product__slides product__slides--{{ image_size }} product-single__photos"
              data-product-media-list
            >
              {%- for i in (1..5) -%}
                <div
                  class="product__photo product__slide svg-placeholder {% if forloop.first %}media--active{% else %}media--hidden{% endif %}"
                  data-slide
                  data-type="image"
                  data-image-id="{{ section.id }}-{{ i }}"
                  data-media-id="{{ section.id }}-media-{{ i }}"
                >
                  {% capture product_name %}product-{{ i }}{% endcapture %}
                  {{ product_name | placeholder_svg_tag: 'svg-placeholder' }}
                </div>
              {%- endfor -%}
            </div>

            {%- if show_thumbnails -%}
              <product-thumbs class="product__thumbs">
                <div class="product__thumbs__holder" data-thumbs-slider>
                  {%- for i in (1..5) -%}
                    <div class="product__thumb{% if forloop.first %} is-active{% endif %}" data-thumb-item>
                      <a
                        class="product__thumb__link"
                        href="#!"
                        data-media-id="{{ section.id }}-media-{{ i }}"
                        data-thumb-link
                      >
                        {% capture product_name %}product-{{ i }}{% endcapture %}
                        {{ product_name | placeholder_svg_tag: 'svg-placeholder' }}
                      </a>
                    </div>
                  {%- endfor -%}
                </div>
              </product-thumbs>

              <script src="{{ 'product-thumbs.js' | asset_url }}" defer="defer"></script>
            {%- endif -%}
          {%- endif -%}
        </product-images>

        <div class="product__content">
          <div
            class="form__wrapper{% unless show_buy_buttons %} form__wrapper--no-buttons{% endunless %}{% unless current_variant.available or onboarding_product %} variant--soldout{% endunless %}{% if settings.form_style == 'classic' %} form__wrapper--classic{% else %} form__wrapper--modern{% endif %}{% if settings.show_newsletter %} show-product-notification{% endif %}"
            data-form-wrapper
          >
            <div class="form__width">
              <div id="Preorder-{{ section.id }}">
                {% if preorder %}
                  {% comment %} Depending whether the product variant is a preorder or not, we will submit a line item property: "preorder" in the cart {% endcomment %}
                  <input
                    type="hidden"
                    name="properties[{{ 'products.product.sale_type' | t }}]"
                    value="{{ 'products.product.pre_order' | t }}"
                    form="{{ product_form_id }}"
                    data-product-preorder
                  >
                {% endif %}
              </div>

              {%- if sibling_color != blank -%}
                <input
                  type="hidden"
                  form="{{ product_form_id }}"
                  name="properties[{{ 'general.siblings.label' | t }}]"
                  value="{{ sibling_color }}"
                >
              {%- endif -%}

              {%- for block in section.blocks -%}
                {%- liquid
                  assign padding_bottom = block.settings.padding_bottom
                  assign bg_accent = block.settings.bg_color
                  assign icon_size = block.settings.icon_size

                  capture block_style
                    if padding_bottom
                      echo '--block-padding-bottom: ' | append: block.settings.padding_bottom | append: 'px;'
                    endif

                    if block.type == 'upsell' or block.type == 'bundle-save' or block.type == 'complementary-products'
                      unless bg_accent == 'rgba(0,0,0,0)' or bg_accent == blank
                        echo '--bg-accent: ' | append: bg_accent | append: ';'
                      endunless
                    endif

                    if icon_size
                      echo '--icon-size:' | append: icon_size | append: 'px;'
                    endif

                    if block.type == 'countdown'
                      assign bg_color = block.settings.bg_color
                      assign text_color = block.settings.color

                      unless bg_color == 'rgba(0,0,0,0)' or bg_color == blank
                        echo '--bg: ' | append: bg_color | append: ';'
                        echo '--countdown-padding: ' | append: 'var(--inner);'
                      endunless

                      unless text_color == 'rgba(0,0,0,0)' or text_color == blank
                        echo '--text: ' | append: text_color | append: ';'
                      endunless
                    endif

                    if block.type == 'badges'
                      assign badge_border_style = block.settings.badge_border_style
                      assign badge_radius = 0

                      if badge_border_style == 'rounded'
                        assign badge_radius = 3
                      elsif badge_border_style == 'pill'
                        assign badge_radius = 300
                      endif

                      echo '--badge-radius:' | append: badge_radius | append: 'px;'
                    endif
                  endcapture

                  if block_style != blank
                    assign block_style = 'style="' | append: block_style | append: '"'
                  endif
                -%}

                {%- case block.type -%}
                  {%- when '@app' -%}
                    {%- render block -%}

                  {%- when 'title' -%}
                    {%- render 'product-title',
                      product: product,
                      block: block,
                      block_style: block_style,
                      is_title_linked: is_title_linked,
                      onboarding_product: onboarding_product,
                      title_material: title_material
                    -%}

                  {%- when 'price' -%}
                    {%- render 'product-price',
                      product: product,
                      block: block,
                      block_style: block_style,
                      onboarding_product: onboarding_product
                    -%}

                  {%- when 'variants' -%}
                    {%- render 'product-variant-picker',
                      product: product,
                      current_variant: current_variant,
                      block: block,
                      block_style: block_style,
                      product_form_id: product_form_id,
                      enable_size_chart: true
                    -%}

                  {%- when 'buttons' -%}
                    {%- render 'product-buttons',
                      block: block,
                      block_style: block_style,
                      product: product,
                      product_form_id: product_form_id,
                      preorder: preorder,
                      onboarding_product: onboarding_product
                    -%}

                  {%- when 'description' -%}
                    {%- render 'product-description', product: product, block: block, block_style: block_style -%}

                  {%- when 'tab_richtext' -%}
                    {%- render 'product-description', product: product, block: block, block_style: block_style -%}

                  {%- when 'accordion' -%}
                    {%- render 'product-description', product: product, block: block, block_style: block_style -%}

                  {%- when 'inventory_countdown' -%}
                    {%- render 'product-inventory', product: product, block: block, block_style: block_style -%}

                  {%- when 'pdp_details_accordion' -%}
                    {%- render 'product-details-accordion', product: product, section: section, block: block, block_style: block_style -%}

                  {%- when 'upsell', 'bundle-save' -%}
                    {%- liquid
                      if block.type == 'upsell'
                        assign product_metafield = product.metafields.theme.upsell.value
                        assign product_list_metafield = product.metafields.theme.upsell_list.value
                        assign fallback_product = block.settings.upsell_product
                        assign fallback_product_list = block.settings.upsell_product_list
                        assign show_available_only = block.settings.show_available_upsell_only
                        assign block_title = 'products.general.upsell_title' | t
                        assign block_class = 'upsell-products'
                        assign wrapper_class = 'product__upsell'
                        assign title_class = 'product-upsell__holder__title'
                      elsif block.type == 'bundle-save'
                        assign product_metafield = product.metafields.theme.bundle.value
                        assign product_list_metafield = product.metafields.theme.bundle_list.value
                        assign fallback_product = block.settings.bundle_product
                        assign fallback_product_list = block.settings.bundle_product_list
                        assign show_available_only = block.settings.show_available_bundle_only
                        assign block_title = block.settings.bundle_title
                        assign block_class = 'bundle-products'
                        assign wrapper_class = 'product__bundle'
                        assign title_class = 'product-bundle__holder__title'
                      endif

                      assign target_product = product_metafield | default: fallback_product
                      assign target_product_list = product_list_metafield | default: fallback_product_list
                      assign slider_enabled = false
                      assign block_tag = 'div'

                      if block.settings.layout == 'slider'
                        assign slider_enabled = true
                        assign block_tag = 'slider-component'
                        assign dots_style = settings.dots_style
                        assign autoplay_speed = false
                        assign autoplay = block.settings.autoplay

                        if autoplay
                          assign autoplay_speed = block.settings.autoplay_speed | times: 1000
                        endif
                      endif
                    -%}

                    {%- if target_product != blank or target_product_list != blank or request.design_mode -%}
                      {%- capture block_products -%}
                        {%- if target_product == blank and target_product_list == blank -%}
                          {%- render 'upsell-product' -%}
                        {%- else -%}
                          {%- if target_product != blank -%}
                            {%- render 'upsell-product', upsell_product: target_product, show_available_upsell_only: show_available_only, slider_enabled: slider_enabled, is_product_block: true -%}
                          {%- endif -%}

                          {%- if target_product_list != blank -%}
                            {%- for list_product in target_product_list -%}
                              {%- render 'upsell-product', upsell_product: list_product, show_available_upsell_only: show_available_only, slider_enabled: slider_enabled, is_product_block: true -%}
                            {%- endfor -%}
                          {%- endif -%}
                        {%- endif -%}
                      {%- endcapture -%}

                      {%- if block_products != blank -%}
                        <div
                          class="product__block {{ block_class }} block-padding"
                          {{ block.shopify_attributes }}
                          {{ block_style }}
                        >
                          <p class="{{ title_class }}">{{ block_title }}</p>
                          <{{ block_tag }}
                            class="{{ wrapper_class }} {{ wrapper_class }}--{{ block.settings.layout }}"
                            {% if slider_enabled %}
                              data-slider
                              data-dots="{{ dots_style }}"
                              data-options='{"autoPlay": {{ autoplay_speed }}, "prevNextButtons": false }'
                            {% endif %}
                            {{ block.shopify_attributes }}
                            {{ block_style }}
                          >
                            {{ block_products }}
                          </{{ block_tag }}>
                        </div>
                      {%- endif -%}
                    {%- endif -%}

                  {%- when 'complementary-products' -%}
                    {%- liquid
                      assign slider_enabled = false

                      if block.settings.layout == 'slider'
                        assign slider_enabled = true
                        assign dots_style = settings.dots_style
                        assign autoplay_speed = false
                        assign autoplay = block.settings.autoplay

                        if autoplay
                          assign autoplay_speed = block.settings.autoplay_speed | times: 1000
                        endif
                      endif
                    -%}
                    <div
                      class="product__block product__complementary block-padding"
                      {{ block.shopify_attributes }}
                      {{ block_style }}
                    >
                      <complementary-products
                        class="complementary-products"
                        data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=10&intent=complementary"
                      >
                        {%- if slider_enabled -%}
                          <slider-component
                            data-dots="{{ dots_style }}"
                            data-options='{"autoPlay": {{ autoplay_speed }}, "prevNextButtons": false }'
                          >
                        {%- endif -%}

                        {%- if recommendations.performed and recommendations.products_count > 0 -%}
                          {%- assign complementary_products_title = 'products.general.complementary_products_title'
                            | t
                          -%}
                          {%- if complementary_products_title != blank -%}
                            <p class="complementary-products__title">{{ complementary_products_title }}</p>
                          {%- endif -%}

                          {%- for product in recommendations.products limit: block.settings.complementary_limit -%}
                            {%- render 'upsell-product', upsell_product: product, slider_enabled: slider_enabled -%}
                          {%- endfor -%}
                        {%- endif -%}

                        {%- if slider_enabled -%}
                          </slider-component>
                        {%- endif -%}
                      </complementary-products>
                    </div>

                    <script src="{{ 'complementary-products.js' | asset_url }}" defer="defer"></script>

                  {%- when 'pickup' -%}
                    {%- render 'stylesheet', name: 'pickup-availability.css', async: false, inline: false, blocking: true -%}

                    {%- assign pick_up_availabilities = current_variant.store_availabilities
                      | where: 'pick_up_enabled', true
                    -%}

                    <pickup-availability
                      class="product__block product__pickup block-padding"
                      {% if current_variant.available and pick_up_availabilities.size > 0 %}
                        available
                      {% endif %}
                      data-root-url="{{ routes.root_url }}"
                      data-variant-id="{{ current_variant.id }}"
                      data-has-only-default-variant="{{ product.has_only_default_variant }}"
                      data-product-page-color-scheme="{{ color_scheme }}"
                      {{ block.shopify_attributes }}
                      {{ block_style }}
                    >
                      <template>
                        <pickup-availability-preview class="pickup__preview">
                          {%- render 'icon-cancel' -%}
                          <div class="pickup__info">
                            <p class="pickup__info__text">
                              {{ 'products.product.pickup_availability.unavailable' | t }}
                            </p>
                            <button class="pickup__button text-link small">
                              {{ 'products.product.pickup_availability.refresh' | t }}
                            </button>
                          </div>
                        </pickup-availability-preview>
                      </template>
                    </pickup-availability>

                    <script src="{{ 'pickup-availability.js' | asset_url }}" defer="defer"></script>

                  {%- when 'code' -%}
                    <div
                      class="product__block product__custom-code block-padding"
                      {{ block_style }}
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.code }}
                    </div>

                  {%- when 'siblings' -%}
                    {%- render 'product-siblings',
                      product: product,
                      product_form_id: product_form_id,
                      current_variant: current_variant,
                      block: block,
                      block_style: block_style,
                      quick_add_product: false
                    -%}

                  {%- when 'text' -%}
                    {%- render 'product-block-text', block: block, block_style: block_style -%}

                  {%- when 'icon' -%}
                    {%- render 'icon', block: block, index: forloop.index0, is_product: true -%}

                  {%- when 'sharing' -%}
                    <div class="product__block block-padding" {{ block.shopify_attributes }} {{ block_style }}>
                      {%- assign share_url = current_variant.url | prepend: request.origin -%}
                      {%- render 'pdp-share', share_url: share_url, share_title: product.title, product: product, section: section, block: block -%}
                    </div>

                  {%- when 'divider' -%}
                    {%- render 'divider', block: block, modifier: 'product__block product__block--divider' -%}

                  {%- when 'line-item' -%}
                    {%- render 'product-properties',
                      product: product,
                      block: block,
                      block_style: block_style,
                      product_form_id: product_form_id
                    -%}

                    {%- when 'features' -%}
                    {%- liquid
                      assign block_id = block.id
                      assign text = block.settings.text
                      assign title = block.settings.title
                      assign image = block.settings.icon_alt
                      assign bg_color = block.settings.bg_color
                      assign text_color = block.settings.color

                      comment
                        Always force dots style to be "line" except if "Circle" is chosen from the global settings
                      endcomment
                      assign dots_style = 'line'
                      if settings.dots_style == 'circle'
                        assign dots_style = 'circle'
                      endif

                      capture style
                        if bg_color != 'rgba(0,0,0,0)' and bg_color != blank
                          echo '--bg-accent: ' | append: bg_color | append: ';'
                        endif

                        if text_color != 'rgba(0,0,0,0)' and text_color != blank
                          echo '--text: ' | append: text_color | append: ';'
                        endif
                      endcapture
                    -%}

                    {%- render 'stylesheet', name: 'feature.css', async: false, inline: false, blocking: true -%}

                    <slider-component
                      class="product__block product__features block-padding"
                      {{ block_style }}
                      data-slider
                      data-slider-fullwidth
                      data-dots="{{ dots_style }}"
                      data-options='{"pageDots": true, "adaptiveHeight": true, "autoPlay": false, "prevNextButtons": false, "fade": false, "draggable": ">1"}'
                    >

                    <div
                      class="product__feature"
                      data-slide="{{ block_id }}"
                      {% if style != blank %}
                        style="{{ style }}"
                      {% endif %}
                      {{ block.shopify_attributes }}
                    >
                      <div class="product__feature__content">
                        <div class="block__icon__container product__feature__heading">
                          {%- assign icon_size = block.settings.icon_size -%}
                          <div class="block__icon" style="--icon-size: {{ icon_size }}px;">
                            {%- liquid
                              if image
                                assign icon_width = icon_size
                                assign icon_width_retina = icon_width | times: 2
                                assign icon_sizes = icon_width | append: 'px'
                                assign icon_widths = icon_width | append: ', ' | append: icon_width_retina
                                render 'image', image: image, width: icon_width_retina, sizes: icon_sizes, widths: icon_widths, show_backfill: false
                              else
                                render 'animated-icon', filename: block.settings.icon_name
                              endif
                            -%}
                          </div>

                          {%- if title != blank -%}
                            <div class="block__icon__text {{ block.settings.text_font_size }}">
                              <p>{{ title }}</p>
                            </div>
                          {%- endif -%}
                        </div>

                        {%- if text != blank -%}
                          <div class="rte">
                            {{ text }}
                          </div>
                        {%- endif -%}
                      </div>
                    </div>

                    </slider-component>

                  {%- when 'popup' -%}
                    {%- render 'product-popup', block: block -%}

                  {%- when 'badges' -%}
                    <div
                      id="Badges-{{ section.id }}"
                      class="product__block product__badges block-padding {{ settings.badge_font_size }}"
                      {{ block.shopify_attributes }}
                      {{ block_style }}
                    >
                      {%- if badge != '' and block.settings.product_badges -%}
                        <span class="badge-box" style="border: 1px solid #000 !important; color: #000 !important;">{{ badge }}</span>
                      {%- endif -%}

                      {%- if preorder and product.available and block.settings.product_badges -%}
                        <span
                          class="badge-box preorder-box"
                          data-preorder-badge
                          style="border: 1px solid #000 !important; color: #000 !important;"
                        >
                          {{- 'products.product.pre_order' | t -}}
                        </span>
                      {%- endif -%}

                      {%- if on_sale and product.available and block.settings.sale_badge -%}
                        <span
                          class="badge-box sale-box"
                          style="
                            background-color: var(--triiiple-neon, #EFFF00) !important;
                            border: 1px solid #000 !important;
                            color: #000 !important;
                          "
                        >{{ sale_percent }}%</span>
                      {%- endif -%}

                      {% for i in (1..3) %}
                        {% assign key = 'custom_badge_' | append: i %}
                        {% assign badge = block.settings[key] %}

                        {% if badge != blank %}
                          <span class="badge-box custom-box" style="border: 1px solid #000 !important; color: #000 !important;">{{ badge }}</span>
                        {% endif %}
                      {% endfor %}
                    </div>

                  {%- when 'countdown' -%}
                    {%- assign layout = block.settings.text_align -%}

                    {%- render 'stylesheet', name: 'countdown.css', async: false, inline: false, blocking: true -%}

                    <div
                      class="product__block countdown-block block-padding flex-column {{ layout }}"
                      {{ block_style }}
                      data-countdown-block
                      {{ block.shopify_attributes }}
                    >
                      <div class="countdown-block__text {{ block.settings.heading_font_size }}">
                        {%- if block.settings.text != blank -%}
                          {{ block.settings.text }}
                        {%- endif -%}
                      </div>

                      <div class="countdown-block__timer">
                        {%- render 'countdown-timer',
                          digits_font_size: block.settings.digits_font_size,
                          text_font_size: block.settings.text_font_size,
                          end_date: block.settings.end_date,
                          end_time: block.settings.end_time,
                          period: block.settings.period,
                          end_message: block.settings.end_message,
                          hide_on_complete: block.settings.hide_on_complete
                        -%}
                      </div>
                    </div>

                  {%- when 'sku' -%}
                    <div
                      class="product__block product__sku block-padding"
                      id="Sku-{{ section.id }}"
                      role="status"
                      {{ block_style }}
                      {{ block.shopify_attributes }}
                    >
                      {{ 'products.product.sku' | t }}: {{ current_variant.sku }}
                    </div>

                  {%- when 'fit-guide' -%}
                    {%- render 'stylesheet', name: 'guide.css', async: false, inline: false, blocking: true -%}

                    {%- liquid
                      assign product_content = product.metafields.custom.product_content.value
                      assign fit_color = block.settings.fit_color
                      assign fit_segment_selected = block.settings.segment_selected | plus: 0

                      if product_content != blank and product_content.fit_guide.value != blank
                        assign fit_segment_selected = product_content.fit_guide.value | plus: 0
                      endif

                      unless fit_color.alpha == 0.0 or fit_color == blank
                        capture style
                          echo '--text:' | append: fit_color
                        endcapture
                      endunless
                    -%}

                    <div
                      class="product__block product__guide guide block-padding"
                      {{ block.shopify_attributes }}
                      {{ block_style }}
                    >
                      {%- if block.settings.heading != blank -%}
                        <p class="guide__heading strong">{{ block.settings.heading }}</p>
                      {%- endif -%}

                      <div class="guide__line" style="{{ style }}">
                        {%- for idx in (1..5) -%}
                          <span
                            {% if forloop.index == fit_segment_selected %}
                              class="is-active"
                            {% endif %}
                          >
                            {{- forloop.index -}}
                          </span>
                        {%- endfor -%}
                      </div>

                      {%- if block.settings.left_label != blank
                        or block.settings.middle_label != blank
                        or block.settings.right_label != blank
                      -%}
                        <div class="guide__content{% unless block.settings.left_label != blank %} guide__content--skip-left{% endunless %}{% unless block.settings.right_label != blank %} guide__content--skip-right{% endunless %}">
                          {%- if block.settings.left_label != blank -%}
                            <small class="guide__left">{{ block.settings.left_label }}</small>
                          {%- endif -%}

                          {%- if block.settings.middle_label != blank -%}
                            <small class="guide__middle">{{ block.settings.middle_label }}</small>
                          {%- endif -%}

                          {%- if block.settings.right_label != blank -%}
                            <small class="guide__right">{{ block.settings.right_label }}</small>
                          {%- endif -%}
                        </div>
                      {%- endif -%}
                    </div>

                  {%- when 'estimate_delivery' -%}
                    {%- liquid
                      assign days = block.settings.days_from_today
                      assign now_timestamp = 'now' | date: '%s'
                      assign delivery_days = days | times: 86400
                      assign delivery_date = now_timestamp | plus: delivery_days | date: '%A, %B %e'
                    -%}

                    <div
                      class="product__block estimate-delivery block-padding {{ block.settings.text_font_size }}"
                      {{ block.shopify_attributes }}
                      {{ block_style }}
                    >
                      {{ block.settings.label }}
                      {{ delivery_date }}
                    </div>
                {%- endcase -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      </div>
    </div>
  </{{ wrapper_tag }}>

  {%- if show_cart_bar -%}
    {%- render 'cart-bar', product: product -%}
  {%- endif -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  {%- if product_sticky_enable -%}
    <script src="{{ 'product-sticky.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- if show_thumbnails -%}
    <script src="{{ 'product-thumbs.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- if first_3d_model -%}
    <script type="application/json" id="ProductJSON-{{ product.id }}">
      {{ product.media | where: 'media_type', 'model' | json }}
    </script>
  {%- endif -%}

  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
</product-info>
